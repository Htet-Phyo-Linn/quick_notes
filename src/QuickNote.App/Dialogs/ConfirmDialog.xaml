<Window x:Class="QuickNote.App.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickNote" Height="210" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#202020">

    <Window.Resources>
        <PathGeometry x:Key="IconWarningGeometry">
            M1,21 h22 L12,2 Z M12,9 v5 M12,17 v2
        </PathGeometry>
        <PathGeometry x:Key="IconInfoGeometry">
            M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M12,8 v2 M12,12 v6
        </PathGeometry>

        <!-- Proper button template: no WPF hover color injection, just opacity -->
        <Style x:Key="ConfirmBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Icon & Title -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <Border x:Name="IconContainer" DockPanel.Dock="Left" Width="36" Height="36"
                    CornerRadius="18" Background="#332B14" Margin="0,0,14,0" VerticalAlignment="Center">
                <Path x:Name="DialogIconPath" Data="{StaticResource IconWarningGeometry}"
                      Stroke="#F59E0B" StrokeThickness="2"
                      StrokeLineJoin="Round" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="18" Height="18" Stretch="Uniform"/>
            </Border>
            <TextBlock x:Name="TitleText" Text="Confirmation" FontWeight="Bold" FontSize="15"
                       Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Message Body -->
        <TextBlock Grid.Row="1" x:Name="MessageText" Text="Are you sure you want to proceed?"
                   FontSize="13" Foreground="#8C8C8C" TextWrapping="Wrap"
                   Margin="50,0,0,16" VerticalAlignment="Top" LineHeight="19"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Click="CancelButton_Click"
                    Style="{StaticResource ConfirmBtnStyle}"
                    Width="85" Height="32" Margin="0,0,10,0"
                    Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#383838"/>
            <Button x:Name="ConfirmBtn" Content="Confirm" Click="ConfirmButton_Click"
                    Style="{StaticResource ConfirmBtnStyle}"
                    Width="90" Height="32"
                    Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"/>
        </StackPanel>
    </Grid>
</Window>
