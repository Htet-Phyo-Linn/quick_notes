<Window x:Class="QuickNote.App.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Height="180" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#202020">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" Text="Enter new name:" 
                   FontWeight="SemiBold" FontSize="13" Foreground="#E6E6E6" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="5" BorderBrush="#383838" BorderThickness="1" Height="36" VerticalAlignment="Top">
            <TextBox x:Name="InputTextBox" BorderThickness="0" Background="Transparent" 
                     Foreground="#FFFFFF" FontSize="13" Padding="8,6" VerticalAlignment="Center"
                     KeyDown="InputTextBox_KeyDown"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" Width="75" Height="28" Margin="0,0,8,0"
                    Background="#2A2A2A" Foreground="#E0E0E0" BorderBrush="#383838" BorderThickness="1" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Confirm" Click="OkButton_Click" Width="80" Height="28"
                    Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
