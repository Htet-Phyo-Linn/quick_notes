<Window x:Class="QuickNote.App.Dialogs.TrashBinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trash Bin" Height="480" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource NotionSidebarBg}">

    <Window.Resources>
        <!-- Button: opacity-only hover, no WPF colour injection -->
        <Style x:Key="TrashBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem: checkbox on left + context menu -->
        <Style x:Key="TrashItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{DynamicResource NotionBorder}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox column -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>

                                <!-- Item content (from ItemTemplate) -->
                                <ContentPresenter Grid.Column="1" Margin="2,9,12,9"/>
                            </Grid>

                            <!-- Right-click context menu -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✔  Select this item" Click="CtxSelect_Click"/>
                                    <Separator/>
                                    <MenuItem Header="↩  Restore" Click="CtxRestore_Click"/>
                                    <MenuItem Header="🗑  Delete permanently" Click="CtxDelete_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource NotionItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource NotionItemSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="EmptyTrashButton" DockPanel.Dock="Right"
                    Content="Empty Trash" Click="EmptyTrashButton_Click"
                    Style="{StaticResource TrashBtnStyle}"
                    Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#B91C1C"
                    Padding="12,5"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="Trash Bin" FontWeight="Bold" FontSize="16"
                           Foreground="{DynamicResource NotionTextPrimary}"/>
                <TextBlock Text="Check items to select · Right-click for options · Use buttons below for bulk actions"
                           FontSize="11" Foreground="{DynamicResource NotionTextSecondary}"/>
            </StackPanel>
        </DockPanel>

        <!-- List -->
        <Border Grid.Row="1" Background="{DynamicResource NotionSearchBg}"
                CornerRadius="6" BorderBrush="{DynamicResource NotionBorder}" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="EmptyLabel" Text="Trash Bin is empty."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource NotionTextMuted}" FontSize="13"
                           Visibility="Collapsed"/>

                <ListBox x:Name="TrashListBox"
                         Background="Transparent" BorderThickness="0"
                         SelectionMode="Multiple"
                         ItemContainerStyle="{StaticResource TrashItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource NotionTextPrimary}"/>
                                <TextBlock Text="{Binding OriginalPath}"
                                           FontSize="11"
                                           Foreground="{DynamicResource NotionTextSecondary}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Footer: bulk actions + close -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="RestoreSelectedButton" Content="Restore Selected"
                        Click="RestoreSelectedButton_Click"
                        Style="{StaticResource TrashBtnStyle}"
                        Background="{DynamicResource NotionButtonBg}"
                        Foreground="{DynamicResource NotionButtonText}"
                        BorderBrush="{DynamicResource NotionButtonBorder}"
                        Padding="10,5" Margin="0,0,8,0" Height="30"/>
                <Button x:Name="DeleteSelectedButton" Content="Delete Selected"
                        Click="DeleteSelectedButton_Click"
                        Style="{StaticResource TrashBtnStyle}"
                        Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#991B1B"
                        Padding="10,5" Height="30"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Close" Click="CloseButton_Click"
                    Style="{StaticResource TrashBtnStyle}"
                    Background="{DynamicResource NotionButtonBg}"
                    Foreground="{DynamicResource NotionButtonText}"
                    BorderBrush="{DynamicResource NotionButtonBorder}"
                    Width="80" Height="30"/>
        </DockPanel>
    </Grid>
</Window>
