<Window x:Class="QuickNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:QuickNote.Core.Models;assembly=QuickNote.Core"
        xmlns:vm="clr-namespace:QuickNote.App.ViewModels"
        mc:Ignorable="d"
        Title="QuickNote — Local-First Markdown Notes" Height="700" Width="1120"
        MinWidth="360" MinHeight="400"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/app.ico"
        Background="{DynamicResource NotionCanvasBg}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewNoteCommand}"/>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding RefreshCommand}"/>
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding NewTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="Tab" Command="{Binding NextTabCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="Tab" Command="{Binding PrevTabCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Notion Dark / Light Dynamic Palette -->
        <SolidColorBrush x:Key="NotionCanvasBg" Color="#191919"/>
        <SolidColorBrush x:Key="NotionSidebarBg" Color="#202020"/>
        <SolidColorBrush x:Key="NotionHeaderBg" Color="#202020"/>
        <SolidColorBrush x:Key="NotionBorder" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="NotionItemHover" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="NotionItemSelected" Color="#333333"/>
        <SolidColorBrush x:Key="NotionTextPrimary" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="NotionTextSecondary" Color="#8C8C8C"/>
        <SolidColorBrush x:Key="NotionTextMuted" Color="#555555"/>
        <SolidColorBrush x:Key="NotionSearchBg" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="NotionButtonBg" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="NotionButtonBorder" Color="#383838"/>
        <SolidColorBrush x:Key="NotionButtonText" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="NotionStatusBarBg" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="NotionOverlayBg" Color="#242424"/>
        <SolidColorBrush x:Key="NotionOverlayHeaderBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="NotionAccent" Color="#2563EB"/>
        <SolidColorBrush x:Key="NotionScrollbarThumb" Color="#3E3E3E"/>
        <SolidColorBrush x:Key="NotionScrollbarThumbHover" Color="#5A5A5A"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

