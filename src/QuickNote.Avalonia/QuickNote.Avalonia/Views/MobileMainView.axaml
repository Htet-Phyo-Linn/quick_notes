<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuickNote.Avalonia.ViewModels"
             xmlns:views="using:QuickNote.Avalonia.Views"
             xmlns:notion="using:QuickNote.Avalonia.Notion"
             xmlns:controls="using:Avalonia.Controls"
             xmlns:models="using:QuickNote.Core.Models"
             x:Class="QuickNote.Avalonia.Views.MobileMainView"
             x:Name="Root"
             x:DataType="views:MobileMainView"
             Background="{Binding AppBackgroundBrush, RelativeSource={RelativeSource Self}}">

    <UserControl.Resources>
        <!-- Material Design & Google Keep Icons -->
        <StreamGeometry x:Key="IconBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconPlus">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
        <StreamGeometry x:Key="IconCloud">M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconFolderPlus">M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z</StreamGeometry>
        <StreamGeometry x:Key="IconDocument">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
        <StreamGeometry x:Key="IconBolt">M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-5.97 10.49z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
        <StreamGeometry x:Key="IconSync">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</StreamGeometry>
        <StreamGeometry x:Key="IconGridView">M3 3h8v8H3V3zm0 10h8v8H3v-8zM13 3h8v8h-8V3zm0 10h8v8h-8v-8z</StreamGeometry>
        <StreamGeometry x:Key="IconListView">M4 5h16v2H4V5zm0 6h16v2H4v-2zm0 6h16v2H4v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconCheckbox">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z</StreamGeometry>
        <StreamGeometry x:Key="IconCode">M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z</StreamGeometry>
        <StreamGeometry x:Key="IconPalette">M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l2.09-2.09C9.28 19.46 10.59 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z</StreamGeometry>
        <StreamGeometry x:Key="IconMenu">M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z</StreamGeometry>
        <StreamGeometry x:Key="IconNotes">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z</StreamGeometry>
        <StreamGeometry x:Key="IconTag">M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
        <StreamGeometry x:Key="IconCheckCircle">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z</StreamGeometry>
        <StreamGeometry x:Key="IconCircleOutline">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z</StreamGeometry>
        <StreamGeometry x:Key="IconSun">M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z</StreamGeometry>
        <StreamGeometry x:Key="IconMoon">M12.3 2a10 10 0 0 0-1.9 19.8 10 10 0 0 0 10.9-10.9A10.02 10.02 0 0 1 12.3 2z</StreamGeometry>
        <StreamGeometry x:Key="IconDotsVertical">M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconImage">M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronUp">M12 8l-6 6 1.41 1.41L12 10.83l4.59 4.58L18 14z</StreamGeometry>
        <StreamGeometry x:Key="IconChevronRight">M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z</StreamGeometry>
        <StreamGeometry x:Key="IconHistory">M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z</StreamGeometry>
        <StreamGeometry x:Key="IconRestore">M14 12c0-1.1-.9-2-2-2s-2 .9-2 2 .9 2 2 2 2-.9 2-2zm-2-9a9 9 0 0 0-9 9H0l4 4 4-4H5c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7a6.97 6.97 0 0 1-5.06-2.2L5.5 17.2A8.96 8.96 0 0 0 12 21a9 9 0 0 0 0-18z</StreamGeometry>
        <StreamGeometry x:Key="IconClock">M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z</StreamGeometry>
        <StreamGeometry x:Key="IconTerminal">M20 4H4c-1.11 0-2 .89-2 2v12c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.11-.89-2-2-2zm0 14H4V8h16v10zm-2-1h-6v-2h6v2zM7.5 17l-1.41-1.41L8.67 13l-2.58-2.59L7.5 9l4 4-4 4z</StreamGeometry>
        <StreamGeometry x:Key="IconSpinner">M12 2 A 10 10 0 1 1 4.93 4.93 L 6.34 6.34 A 8 8 0 1 0 12 4 Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Remove intrusive focus border outlines on mobile TextBoxes -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- TreeView / ListBox Selection Card Styles -->
        <Style Selector="Border.FolderNodeCard">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.FolderNodeCard.NodeSelected">
            <Setter Property="Background" Value="#1a2d48" />
            <Setter Property="BorderBrush" Value="#3390ec" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.FlatNoteCard">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.FlatNoteCard.Selected">
            <Setter Property="Background" Value="#1a2d48" />
            <Setter Property="BorderBrush" Value="#3390ec" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- FLOATING TOAST / SYNCING NOTIFICATION CARD (Top Pill Web-Style UX, Circular Spinner, Anti-Overflow, Dismissible) -->
        <Border x:Name="ToastCapsule"
                IsVisible="False"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                MaxWidth="360"
                Margin="16,64,16,0"
                Padding="14,10"
                CornerRadius="20"
                Background="#F0141a24"
                BorderBrush="{Binding AccentBrush}"
                BorderThickness="1.5"
                BoxShadow="0 8 28 #80000000"
                ZIndex="4000">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- Left: Circular Spinner or Completion Icon -->
                <Panel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                    <!-- Circular Spinner Ring (Rotating during sync) -->
                    <Border x:Name="ToastSpinnerContainer" Width="24" Height="24" VerticalAlignment="Center" IsVisible="False">
                        <PathIcon x:Name="ToastSpinnerIcon"
                                  Data="{StaticResource IconSpinner}"
                                  Width="18"
                                  Height="18"
                                  Foreground="{Binding AccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="50%,50%" />
                    </Border>

                    <!-- Status Icon (Checkmark or Error Close) -->
                    <Border x:Name="ToastIconContainer" Width="24" Height="24" CornerRadius="12" Background="#2010b981" VerticalAlignment="Center">
                        <PathIcon x:Name="ToastIcon" Data="{StaticResource IconCheck}" Width="13" Height="13" Foreground="#10b981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Panel>

                <!-- Center: Status / Progress Text (Strictly bounded, wraps or trims) -->
                <TextBlock Grid.Column="1"
                           x:Name="ToastMessageText"
                           Text="Sync complete"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#f8fafc"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           MinWidth="50" />

                <!-- Right: Close Button to dismiss toast -->
                <Button Grid.Column="2"
                        Width="30"
                        Height="30"
                        Margin="8,0,0,0"
                        Padding="0"
                        Background="#25ffffff"
                        BorderThickness="0"
                        CornerRadius="15"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OnCloseToastClick"
                        ToolTip.Tip="Close Notification">
                    <PathIcon Data="{StaticResource IconClose}"
                              Width="12"
                              Height="12"
                              Foreground="#ffffff"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>
        <!-- SCREEN 1: GOOGLE KEEP STYLE NOTES FEED -->
        <Grid x:Name="NotesFeedScreen" RowDefinitions="Auto,Auto,*,Auto" Background="{Binding AppBackgroundBrush}" IsVisible="True">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Grid.Transitions>

            <!-- Top Floating Search Bar Capsule or Selection Action Bar (Google Keep Style) -->
            <Border Grid.Row="0" Background="Transparent" Padding="14,14,14,6">
                <Panel>
                    <!-- Normal Search Bar Capsule -->
                    <Border IsVisible="{Binding !IsSelectionMode}"
                            Background="{Binding GlassSurfaceBrush}"
                            BorderBrush="{Binding GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Height="48"
                            Padding="12,0"
                            BoxShadow="0 4 20 #25000000">
                        <Panel>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <!-- Hamburger Menu Button (opens Left Sidebar) -->
                            <Button Grid.Column="0"
                                    x:Name="HamburgerButton"
                                    Click="OnToggleLeftDrawerClick"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    CornerRadius="16">
                                <PathIcon Data="{StaticResource IconMenu}" Width="20" Height="20" Foreground="{Binding TextPrimaryBrush}" />
                            </Button>

                            <!-- Search TextBox -->
                            <TextBox Grid.Column="1"
                                     x:Name="SearchBox"
                                     Text="{Binding SearchQuery, Mode=TwoWay}"
                                     PlaceholderText="Search your notes"
                                     Background="Transparent"
                                     Foreground="{Binding TextPrimaryBrush}"
                                     BorderThickness="0"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     Margin="4,0" />

                            <!-- Clear Search Button -->
                            <Button Grid.Column="2"
                                    Click="OnClearSearchClick"
                                    Background="Transparent"
                                    Foreground="{Binding TextSecondaryBrush}"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasSearchQuery}">
                                <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                            </Button>

                            <!-- Right Actions: Theme Toggle + View Toggle + Cloud Sync Pill -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <!-- Theme Toggle (Light / Dark) -->
                                <Button Click="OnToggleThemeClick"
                                        Background="Transparent"
                                        Padding="6"
                                        CornerRadius="16"
                                        ToolTip.Tip="Switch theme">
                                    <PathIcon Data="{Binding ThemeIconGeometry}" Width="17" Height="17" Foreground="{Binding TextSecondaryBrush}" />
                                </Button>

                                <!-- Toggle Grid / List View -->
                                <Button Click="OnToggleViewModeClick"
                                        Background="Transparent"
                                        Padding="6"
                                        CornerRadius="16"
                                        ToolTip.Tip="Switch view layout">
                                    <PathIcon Data="{Binding ViewModeIcon}" Width="18" Height="18" Foreground="{Binding TextSecondaryBrush}" />
                                </Button>

                                <!-- Cloud Sync Avatar / Pill -->
                                <Border x:Name="CloudSyncBadge"
                                        Background="{Binding ChipUnselectedBackgroundBrush}"
                                        CornerRadius="16"
                                        Padding="7"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Tapped="OnCloudSyncBadgeTapped"
                                        ToolTip.Tip="Google Drive account">
                                    <PathIcon Data="{StaticResource IconCloud}"
                                              Width="15"
                                              Height="15"
                                              Foreground="{Binding CloudSyncIconBrush}" />
                                </Border>

                                <!-- Settings & Dictionary Icon Button -->
                                <Border Background="{Binding ChipUnselectedBackgroundBrush}"
                                        CornerRadius="16"
                                        Padding="7"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Tapped="OnOpenSettingsModalClick"
                                        ToolTip.Tip="Settings, Themes &amp; Dictionary">
                                    <PathIcon Data="{StaticResource IconSettings}"
                                              Width="15"
                                              Height="15"
                                              Foreground="{Binding TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Modern Google Keep Style Hairline Sync Progress Line -->
                        <ProgressBar x:Name="TopSyncProgressBar"
                                     IsIndeterminate="True"
                                     Height="2"
                                     VerticalAlignment="Bottom"
                                     HorizontalAlignment="Stretch"
                                     Margin="14,0,14,0"
                                     Foreground="{Binding AccentBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CornerRadius="0,0,12,12"
                                     IsVisible="False" />
                        </Panel>
                    </Border>

                    <!-- Selection Mode: Contextual Action Top Bar -->
                    <Border IsVisible="{Binding IsSelectionMode}"
                            Background="{Binding SelectionBarBackgroundBrush}"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Height="48"
                            Padding="12,0"
                            BoxShadow="0 4 20 #35000000">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Cancel / Exit Selection Button -->
                            <Button Grid.Column="0"
                                    Click="OnCancelSelectionClick"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    CornerRadius="16">
                                <PathIcon Data="{StaticResource IconClose}" Width="18" Height="18" Foreground="{Binding TextPrimaryBrush}" />
                            </Button>

                            <!-- Selection Counter -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectionCountText}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0" />

                            <!-- Select All / Deselect All Toggle Button -->
                            <Button Grid.Column="2"
                                    Click="OnToggleSelectAllNotesClick"
                                    Background="{Binding GlassSurfaceBrush}"
                                    BorderBrush="{Binding AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectAllButtonText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Panel>
            </Border>

            <!-- Tag Filter Chips (Horizontal Scroll, replaces folder list on main page) -->
            <Border Grid.Row="1" Background="Transparent" Padding="14,2,14,8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TagChipsPanel" Orientation="Horizontal" Spacing="8">
                        <!-- Populated dynamically in code-behind with All Notes, #tags, + Tag -->
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Notes Card Staggered Grid Feed -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <!-- Active Tag Filter Pill -->
                <Border Grid.Row="0"
                        x:Name="ActiveTagBanner"
                        IsVisible="{Binding HasSelectedTag}"
                        Background="{Binding GlassSurfaceBrush}"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,4"
                        Margin="14,0,14,8"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding SelectedTagText}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                        <Button Click="OnClearSelectedTagClick" Background="Transparent" Foreground="{Binding TextSecondaryBrush}" Padding="2" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" Foreground="{Binding TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Notes Card Staggered Grid Feed (Visible in Grid View) -->
                <ScrollViewer Grid.Row="1"
                              x:Name="NotesScrollViewer"
                              IsVisible="{Binding IsGridFeedVisible}"
                              Padding="14,4,14,14"
                              IsScrollInertiaEnabled="True"
                              IsScrollChainingEnabled="False">
                    <ItemsControl ItemsSource="{Binding FilteredNotes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:StaggeredGridPanel Columns="{Binding GridColumns}" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:MobileNoteItem">
                                <Border CornerRadius="16"
                                        Background="{Binding CardBackground}"
                                        BorderBrush="{Binding EffectiveBorderBrush}"
                                        BorderThickness="{Binding EffectiveBorderThickness}"
                                        Padding="14,12"
                                        ClipToBounds="True"
                                        PointerPressed="OnNoteCardPointerPressed"
                                        PointerMoved="OnNoteCardPointerMoved"
                                        PointerReleased="OnNoteCardPointerReleased"
                                        PointerCaptureLost="OnNoteCardPointerCaptureLost"
                                        Tapped="OnNoteCardTapped">
                                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                                        <!-- Header: Title + Category badge or Selection Checkmark -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding CardTextBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <!-- Normal Folder Badge (hidden in selection mode) -->
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding !IsSelectionMode}"
                                                    Background="{Binding FolderBadgeBg}"
                                                    CornerRadius="6"
                                                    Padding="6,2"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding FolderName}" FontSize="10" Foreground="{Binding FolderBadgeFg}" />
                                            </Border>

                                            <!-- Selection Checkbox Badge (visible in selection mode) -->
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding IsSelectionMode}"
                                                    Background="{Binding SelectionCheckBackground}"
                                                    BorderBrush="{Binding SelectionCheckBorderBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="11"
                                                    Width="22"
                                                    Height="22"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Center">
                                                <PathIcon Data="{StaticResource IconCheck}"
                                                          Width="12"
                                                          Height="12"
                                                          Foreground="#ffffff"
                                                          IsVisible="{Binding IsSelected}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Body: Snippet Preview with multiline wrapping for staggered heights -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Snippet}"
                                                   FontSize="12"
                                                   Foreground="{Binding SnippetBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,6" />

                                        <!-- Tags Row -->
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" Margin="0,0,0,6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppSelectedBackground}" CornerRadius="6" Padding="6,2" Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Footer: Timestamp -->
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding FormattedDate}"
                                                   FontSize="10"
                                                   Foreground="{Binding DateBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Windows-Style Collapsible Folder Hierarchy & File List (Visible in List View) -->
                <TreeView Grid.Row="1"
                          x:Name="MobileFolderTreeView"
                          ItemsSource="{Binding FolderNodes}"
                          IsVisible="{Binding IsFolderTreeVisible}"
                          Background="Transparent"
                          Padding="14,4,14,14"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.IsScrollInertiaEnabled="True">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="models:FolderNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="MinHeight" Value="44" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2,0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="44" />
                        </Style>
                        <!-- Hide external chevron completely so cards span flush with symmetrical margins -->
                        <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                            <Setter Property="IsVisible" Value="False" />
                            <Setter Property="Width" Value="0" />
                            <Setter Property="Height" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                        <!-- Remove default ugly TreeViewItem selected/focus highlight -->
                        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="TreeViewItem:focus /template/ Border#PART_LayoutRoot">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <!-- Rotate internal chevron when folder expands -->
                        <Style Selector="TreeViewItem:expanded PathIcon.FolderChevron">
                            <Setter Property="RenderTransform">
                                <RotateTransform Angle="180" />
                            </Setter>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="models:FolderNode" ItemsSource="{Binding Children}">
                            <Border Classes="FolderNodeCard"
                                    Classes.NodeSelected="{Binding IsSelected}"
                                    CornerRadius="12"
                                    MinHeight="48"
                                    Margin="0,3,0,3"
                                    Padding="12,8"
                                    VerticalAlignment="Center"
                                    Tapped="OnFolderNodeRowTapped"
                                    PointerPressed="OnFolderNodePointerPressed"
                                    PointerMoved="OnFolderNodePointerMoved"
                                    PointerReleased="OnFolderNodePointerReleased"
                                    PointerCaptureLost="OnFolderNodePointerCaptureLost">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <!-- Left Section: Folder Chevron + Icon Badge -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <!-- Inline folder expand/collapse chevron -->
                                        <Border Width="18" Height="18" VerticalAlignment="Center" IsVisible="{Binding IsDirectory}">
                                            <PathIcon Classes="FolderChevron"
                                                      Data="{StaticResource IconChevronUp}"
                                                      Width="12"
                                                      Height="12"
                                                      Foreground="{DynamicResource AppTextSecondary}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      RenderTransformOrigin="50%,50%">
                                                <PathIcon.RenderTransform>
                                                    <RotateTransform Angle="90" />
                                                </PathIcon.RenderTransform>
                                            </PathIcon>
                                        </Border>

                                        <!-- Folder (amber) or Document (blue) Icon Badge -->
                                        <Border Width="30" Height="30" CornerRadius="8" Background="#14f59e0b" IsVisible="{Binding IsDirectory}" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconFolder}"
                                                      Width="18"
                                                      Height="18"
                                                      Foreground="#f59e0b"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />
                                        </Border>
                                        <Border Width="30" Height="30" CornerRadius="8" Background="#1438bdf8" IsVisible="{Binding !IsDirectory}" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconDocument}"
                                                      Width="16"
                                                      Height="16"
                                                      Foreground="#38bdf8"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Display Name (File Name or Folder Name) -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Right Section: Folder Note Count Chip or Selection Checkbox -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <!-- Folder note count chip (visible only for directories) -->
                                        <Border IsVisible="{Binding IsDirectory}"
                                                Background="#143b82f6"
                                                CornerRadius="8"
                                                Padding="7,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Children.Count, StringFormat='{}{0}'}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#60a5fa" />
                                        </Border>

                                        <!-- Selection Checkbox (visible in selection mode) -->
                                        <Border IsVisible="{Binding $parent[views:MobileMainView].IsSelectionMode}"
                                                Width="22"
                                                Height="22"
                                                CornerRadius="11"
                                                VerticalAlignment="Center">
                                            <Panel>
                                                <!-- Unselected Circle Outline -->
                                                <Border Width="22" Height="22" CornerRadius="11"
                                                        BorderThickness="1.5"
                                                        BorderBrush="#4b5563"
                                                        Background="Transparent"
                                                        IsVisible="{Binding !IsSelected}" />
                                                <!-- Selected Filled Circle with Checkmark -->
                                                <Border Width="22" Height="22" CornerRadius="11"
                                                        Background="#3390ec"
                                                        IsVisible="{Binding IsSelected}">
                                                    <PathIcon Data="{StaticResource IconCheck}"
                                                              Width="12"
                                                              Height="12"
                                                              Foreground="#ffffff"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>
                                            </Panel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Flat File List when searching/filtering in List View (Virtualized) -->
                <ListBox Grid.Row="1"
                         x:Name="FlatFileListListBox"
                         ItemsSource="{Binding FilteredNotes}"
                         IsVisible="{Binding IsFlatFileListVisible}"
                         Background="Transparent"
                         Padding="14,4,14,14"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.IsScrollInertiaEnabled="True">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:MobileNoteItem">
                            <Border CornerRadius="12"
                                    Classes="FlatNoteCard"
                                    Classes.Selected="{Binding IsSelected}"
                                    Padding="12,8"
                                    MinHeight="48"
                                    Margin="0,3,0,3"
                                    Tapped="OnFlatFileNoteTapped"
                                    PointerPressed="OnFlatFilePointerPressed"
                                    PointerMoved="OnFlatFilePointerMoved"
                                    PointerReleased="OnFlatFilePointerReleased"
                                    PointerCaptureLost="OnFlatFilePointerCaptureLost">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1438bdf8" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconDocument}"
                                                  Width="16"
                                                  Height="16"
                                                  Foreground="#38bdf8"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource AppHover}"
                                                CornerRadius="6"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasFolderName}">
                                            <TextBlock Text="{Binding FolderName}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondary}" />
                                        </Border>
                                        <!-- Selection Checkbox -->
                                        <Border IsVisible="{Binding $parent[views:MobileMainView].IsSelectionMode}"
                                                Width="22"
                                                Height="22"
                                                CornerRadius="11"
                                                VerticalAlignment="Center">
                                            <Panel>
                                                <Border Width="22" Height="22" CornerRadius="11"
                                                        BorderThickness="1.5"
                                                        BorderBrush="#4b5563"
                                                        Background="Transparent"
                                                        IsVisible="{Binding !IsSelected}" />
                                                <Border Width="22" Height="22" CornerRadius="11"
                                                        Background="#3390ec"
                                                        IsVisible="{Binding IsSelected}">
                                                    <PathIcon Data="{StaticResource IconCheck}"
                                                              Width="12"
                                                              Height="12"
                                                              Foreground="#ffffff"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>
                                            </Panel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State (When no notes match) -->
                <StackPanel IsVisible="{Binding IsNotesEmpty}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Margin="20">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{Binding GlassSurfaceBrush}" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconDocument}" Width="28" Height="28" Foreground="{Binding AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No notes here yet" FontSize="18" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Tap the + button below to create your first note" FontSize="13" Foreground="{Binding TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Modern Telegram Liquid Glass Floating Bottom Dock (Issue 7) -->
            <Border Grid.Row="3"
                    Margin="12,0,12,12"
                    Height="58"
                    CornerRadius="29"
                    Background="{Binding FloatingBarBackgroundBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="1"
                    Padding="8,5"
                    BoxShadow="0 8 32 #35000000">
                <Panel>
                    <!-- Normal Mode: Floating Pill Dock -->
                    <Grid IsVisible="{Binding !IsSelectionMode}" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <!-- Quick Checklist Note -->
                        <Button Grid.Column="0"
                                Click="OnNewChecklistNoteClick"
                                Width="40" Height="40"
                                CornerRadius="20"
                                Background="{Binding ChipUnselectedBackgroundBrush}"
                                BorderBrush="{Binding GlassBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="New checklist">
                            <PathIcon Data="{StaticResource IconCheckbox}" Width="17" Height="17" Foreground="{Binding AccentBrush}" />
                        </Button>

                        <!-- Quick Code Note -->
                        <Button Grid.Column="1"
                                Click="OnNewCodeNoteClick"
                                Width="40" Height="40"
                                CornerRadius="20"
                                Background="{Binding ChipUnselectedBackgroundBrush}"
                                BorderBrush="{Binding GlassBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,6,0"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="New code note">
                            <PathIcon Data="{StaticResource IconCode}" Width="17" Height="17" Foreground="{Binding AccentBrush}" />
                        </Button>

                        <!-- Sync Button -->
                        <Button Grid.Column="2"
                                Click="OnSyncClick"
                                Width="40" Height="40"
                                CornerRadius="20"
                                Background="{Binding ChipUnselectedBackgroundBrush}"
                                BorderBrush="{Binding GlassBorderBrush}"
                                BorderThickness="1"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Sync notes">
                            <PathIcon Data="{StaticResource IconSync}" Width="16" Height="16" Foreground="{Binding CloudSyncIconBrush}" />
                        </Button>

                        <!-- Note Count Capsule Badge -->
                        <Border Grid.Column="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{Binding ChipUnselectedBackgroundBrush}"
                                BorderBrush="{Binding GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,4">
                            <TextBlock Text="{Binding NoteCountStatus}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- Telegram Liquid Glass FAB (+) -->
                        <Border Grid.Column="4"
                                Width="44" Height="44"
                                CornerRadius="22"
                                Background="{Binding FabBackgroundBrush}"
                                BoxShadow="0 4 16 #603390ec"
                                VerticalAlignment="Center"
                                Margin="4,0,2,0">
                            <Button Click="OnFabNewNoteClick"
                                    Width="44" Height="44"
                                    CornerRadius="22"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    ToolTip.Tip="New note">
                                <PathIcon Data="{StaticResource IconPlus}" Width="20" Height="20" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Border>
                    </Grid>

                    <!-- Selection Mode: Move, Copy, Delete Actions -->
                    <Grid IsVisible="{Binding IsSelectionMode}" ColumnDefinitions="*,*,*" VerticalAlignment="Center">
                        <!-- Move Action -->
                        <Button Grid.Column="0"
                                Click="OnBatchMoveNotesClick"
                                Background="#143b82f6"
                                BorderBrush="#203b82f6"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                Margin="3,0"
                                Padding="8,5"
                                CornerRadius="16">
                            <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="#3b82f6" HorizontalAlignment="Center" />
                                <TextBlock Text="Move" FontSize="11" FontWeight="SemiBold" Foreground="#93c5fd" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Copy Action -->
                        <Button Grid.Column="1"
                                Click="OnBatchCopyNotesClick"
                                Background="#148b5cf6"
                                BorderBrush="#208b5cf6"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                Margin="3,0"
                                Padding="8,5"
                                CornerRadius="16">
                            <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource IconCopy}" Width="16" Height="16" Foreground="#a78bfa" HorizontalAlignment="Center" />
                                <TextBlock Text="Copy" FontSize="11" FontWeight="SemiBold" Foreground="#c4b5fd" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Delete Action -->
                        <Button Grid.Column="2"
                                Click="OnBatchDeleteNotesClick"
                                Background="#14ef4444"
                                BorderBrush="#20ef4444"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                Margin="3,0"
                                Padding="8,5"
                                CornerRadius="16">
                            <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource IconTrash}" Width="16" Height="16" Foreground="#ef4444" HorizontalAlignment="Center" />
                                <TextBlock Text="Delete" FontSize="11" FontWeight="SemiBold" Foreground="#fca5a5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Panel>
            </Border>
        </Grid>

        <!-- SCREEN 2: NATIVE ANDROID NOTE EDITOR -->
        <Grid x:Name="NoteEditorScreen" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{Binding AppBackgroundBrush}" IsVisible="False">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Grid.Transitions>

            <!-- Top Editor App Bar with Safe Inset -->
            <Border Grid.Row="0" Background="{Binding GlassHeaderBackgroundBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="10,14,12,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Back Arrow (Returns to Notes Feed) -->
                    <Button Grid.Column="0"
                            Click="OnEditorBackClick"
                            Background="Transparent"
                            Foreground="{Binding TextPrimaryBrush}"
                            Padding="8"
                            CornerRadius="20"
                            VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconBack}" Width="20" Height="20" Foreground="{Binding TextPrimaryBrush}" />
                    </Button>

                    <!-- Editable Note Title -->
                    <TextBox Grid.Column="1"
                             x:Name="NoteTitleTextBox"
                             Text="{Binding ActiveNoteTitle, Mode=TwoWay}"
                             PlaceholderText="Note Title"
                             FontSize="22"
                             FontWeight="Bold"
                             Foreground="{Binding TextPrimaryBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             MinHeight="38"
                             MaxHeight="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="4,2"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Margin="4,0"
                             KeyDown="OnNoteTitleKeyDown" />

                    <!-- 3-Dots More Menu Button (Issue 6: Copy, Move, Delete) -->
                    <Button Grid.Column="2"
                            x:Name="BtnEditorMoreMenu"
                            Click="OnShowNoteEditorMenuClick"
                            Background="Transparent"
                            Foreground="{Binding TextPrimaryBrush}"
                            Padding="8"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            ToolTip.Tip="More options">
                        <PathIcon Data="{StaticResource IconDotsVertical}" Width="20" Height="20" Foreground="{Binding TextPrimaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Tags Bar in Note Editor (Full width scrollable like Windows software) -->
            <Border Grid.Row="1" x:Name="EditorTagsBar" Background="{Binding GlassSurfaceBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6,12,6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Tag Icon -->
                        <PathIcon Data="{StaticResource IconTag}" Width="13" Height="13" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />

                        <!-- Dynamic Note Tags Panel -->
                        <StackPanel x:Name="EditorTagsPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />

                        <!-- Add Tag Button -->
                        <Button x:Name="BtnShowAddTag"
                                Click="OnShowAddTagClick"
                                Background="{Binding ChipUnselectedBackgroundBrush}"
                                BorderBrush="{Binding GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Height="24"
                                Padding="8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconPlus}" Width="9" Height="9" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Tag" FontSize="11" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Inline Input for Adding a Tag -->
                        <Border x:Name="EditorAddTagContainer"
                                Background="{Binding GlassSurfaceBrush}"
                                BorderBrush="{Binding AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Height="24"
                                Padding="6,0,4,0"
                                IsVisible="False"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="#" Foreground="{Binding AccentBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBox x:Name="EditorNewTagTextBox"
                                         PlaceholderText="tag..."
                                         FontSize="11"
                                         MinHeight="0"
                                         Height="20"
                                         Padding="2,0"
                                         Background="Transparent"
                                         Foreground="{Binding TextPrimaryBrush}"
                                         BorderThickness="0"
                                         MinWidth="60"
                                         MaxWidth="140"
                                         KeyDown="OnEditorNewTagKeyDown"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" />
                                <Button Click="OnConfirmAddTagClick"
                                        Content="✓"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#10b981"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Height="20"
                                        Padding="3,0"
                                        VerticalAlignment="Center" />
                                <Button Click="OnCancelAddTagClick"
                                        Content="✕"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{Binding TextSecondaryBrush}"
                                        FontSize="10"
                                        Height="20"
                                        Padding="3,0"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Last Modified Property Row on Android (Dedicated New Line like Windows) -->
            <Border Grid.Row="2"
                    x:Name="EditorLastModifiedBar"
                    Background="{Binding GlassSurfaceBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,4,12,6"
                    IsVisible="{Binding HasCurrentNoteLastModified}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,2,0">
                        <PathIcon Data="{StaticResource IconClock}" Width="12" Height="12" Foreground="{Binding TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Updated" Foreground="{Binding TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Click="OnEditorVersionHistoryClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,2"
                            CornerRadius="6"
                            Cursor="Hand"
                            ToolTip.Tip="{Binding CurrentNoteLastModifiedFullText}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentNoteLastModifiedText}"
                                   FontSize="11"
                                   Foreground="{Binding TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Full-Screen Milkdown WYSIWYG Markdown Canvas -->
            <notion:NotionEditorControl x:Name="MobileNotionEditor"
                                        Grid.Row="3"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />

            <!-- Material Mobile Formatting Toolbar (Floats above soft keyboard) -->
            <Border Grid.Row="4"
                    x:Name="FormattingBar"
                    Background="{Binding EditorToolbarBackgroundBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Height="48"
                    Padding="6,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Focusable="False" Click="OnFormatH1Click" Width="40" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                            <TextBlock Text="H1" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Button>
                        <Button Focusable="False" Click="OnFormatH2Click" Width="40" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                            <TextBlock Text="H2" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Button>
                        <Button Focusable="False" Click="OnFormatBoldClick" Width="38" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Button>
                        <Button Focusable="False" Click="OnFormatItalicClick" Width="38" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                            <TextBlock Text="I" FontFamily="Times New Roman, Georgia, serif" FontStyle="Italic" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Button>
                        <Button Focusable="False" Click="OnFormatBulletClick" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="10,0">
                            <TextBlock Text="• List" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Button>
                        <Button Focusable="False" Click="OnFormatNumberedClick" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="10,0">
                            <TextBlock Text="1. List" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Button>
                        <Button Focusable="False" Click="OnFormatTodoClick" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="10,0">
                            <TextBlock Text="☑ Todo" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Button>
                        <Button Focusable="False" Click="OnFormatCodeClick" Width="42" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                            <TextBlock Text="&lt;/&gt;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Button>
                        <Button Focusable="False" Click="OnFormatQuoteClick" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="10,0">
                            <TextBlock Text="&quot; Quote" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Button>
                        <Button Focusable="False" Click="OnInsertImageClick" Height="36" CornerRadius="8" Background="{Binding ChipUnselectedBackgroundBrush}" Foreground="{Binding AccentBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="10,0" ToolTip.Tip="Insert Image">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconImage}" Width="15" Height="15" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Image" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MODAL 1: GOOGLE DRIVE ACCOUNT & SYNC DETAILS -->
        <Grid x:Name="GoogleDriveAccountModal" Background="#a0000000" IsVisible="False" PointerPressed="OnCloseAccountModalClick">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{Binding ModalBackgroundBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="20" Width="340" BoxShadow="0 8 32 #50000000"
                    PointerPressed="OnModalContentPointerPressed">
                <StackPanel Spacing="16">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconCloud}" Width="20" Height="20" Foreground="#3b82f6" />
                            <TextBlock Text="Google Drive Cloud Sync" FontSize="16" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCloseAccountModalClick" Background="Transparent" Foreground="{Binding TextSecondaryBrush}" Padding="4">
                            <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" Foreground="{Binding TextSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Account Email Info -->
                    <Border Background="{Binding GlassSurfaceBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Connected Account" FontSize="11" Foreground="{Binding TextMutedBrush}" />
                            <TextBlock Text="{Binding ConnectedAccountEmail}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Last Sync Timestamp -->
                    <Border Background="{Binding GlassSurfaceBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Last Synced" FontSize="11" Foreground="{Binding TextMutedBrush}" />
                            <TextBlock Text="{Binding LastSyncTimeText}" FontSize="13" Foreground="{Binding TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Sync Progress / Status Indicator (Issue 1 & 4) -->
                    <Border x:Name="SyncProgressContainer"
                            IsVisible="False"
                            Background="{Binding GlassSurfaceBrush}"
                            BorderBrush="{Binding GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="SyncPhaseLabel" Text="Syncing with Google Drive..." FontSize="12" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" />
                                <TextBlock x:Name="SyncPercentLabel" Grid.Column="1" Text="In progress" FontSize="11" Foreground="{Binding AccentBrush}" />
                            </Grid>
                            <ProgressBar x:Name="SyncModalProgressBar" IsIndeterminate="True" Height="4" CornerRadius="2" Foreground="{Binding AccentBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Spacing="10">
                        <Button x:Name="BtnConnectGoogle"
                                Click="OnConnectGoogleClick"
                                Background="#2563eb"
                                Foreground="#ffffff"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Height="40"
                                CornerRadius="10"
                                FontWeight="SemiBold"
                                Content="Connect Google Drive" />

                        <Button x:Name="BtnSyncNow"
                                Click="OnSyncNowClick"
                                Background="#10b981"
                                Foreground="#ffffff"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Height="40"
                                CornerRadius="10"
                                FontWeight="SemiBold"
                                Content="Sync Now" />

                        <Button x:Name="BtnDisconnectGoogle"
                                Click="OnDisconnectGoogleClick"
                                Background="#1aef4444"
                                BorderBrush="#35ef4444"
                                BorderThickness="1"
                                Foreground="#ef4444"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Height="36"
                                CornerRadius="10"
                                FontWeight="SemiBold"
                                Content="Disconnect Account" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 2: IN-APP GOOGLE LOGIN WEBVIEW -->
        <Grid x:Name="GoogleDriveAuthModal" RowDefinitions="Auto,*" Background="{Binding AppBackgroundBrush}" IsVisible="False">
            <Border Grid.Row="0" Background="{Binding GlassHeaderBackgroundBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="16,36,16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconCloud}" Width="18" Height="18" Foreground="#3b82f6" />
                        <TextBlock Text="Sign in to Google" FontSize="16" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="OnCloseAuthModalClick" Background="Transparent" Foreground="{Binding TextSecondaryBrush}" Padding="6">
                        <PathIcon Data="{StaticResource IconClose}" Width="18" Height="18" Foreground="{Binding TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Google Login WebView -->
            <controls:NativeWebView x:Name="AuthWebView" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>

        <!-- MODAL 3: CREATE NEW FOLDER -->
        <Grid x:Name="NewFolderModal" Background="#a0000000" IsVisible="False" PointerPressed="OnCancelNewFolderClick">
            <Border Background="{Binding ModalBackgroundBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="320"
                    MaxHeight="520"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20"
                    BoxShadow="0 8 32 #50000000"
                    PointerPressed="OnModalContentPointerPressed">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconFolderPlus}" Width="22" Height="22" Foreground="#3b82f6" />
                        <TextBlock Text="New Folder" FontSize="18" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Folder Name Input -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Folder Name" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}" />
                        <TextBox x:Name="NewFolderNameTextBox"
                                 PlaceholderText="Folder name"
                                 Background="{Binding GlassSurfaceBrush}"
                                 Foreground="{Binding TextPrimaryBrush}"
                                 BorderBrush="{Binding GlassBorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="8"
                                 Padding="12,10"
                                 FontSize="14" />
                    </StackPanel>

                    <!-- Parent Folder Selector (Issue 2: parent folder search bar & dropdown) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Parent Folder (Optional)" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}" />
                        <!-- Selector Trigger Button -->
                        <Button x:Name="BtnParentFolderSelector"
                                Click="OnToggleParentFolderDropdownClick"
                                Background="{Binding GlassSurfaceBrush}"
                                BorderBrush="{Binding GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="#3b82f6" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="SelectedParentFolderLabel" Text="/ (Root - Top level)" FontSize="13" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="14" Height="14" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Searchable Folder Dropdown List (Collapsible) -->
                        <Border x:Name="ParentFolderDropdownContainer"
                                Background="{Binding GlassSurfaceBrush}"
                                BorderBrush="{Binding GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                MaxHeight="170"
                                Padding="6"
                                IsVisible="False">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Search parent folders input -->
                                <TextBox Grid.Row="0"
                                         x:Name="ParentFolderSearchBox"
                                         PlaceholderText="Search parent folder..."
                                         Background="{Binding ModalBackgroundBrush}"
                                         Foreground="{Binding TextPrimaryBrush}"
                                         BorderBrush="{Binding GlassBorderBrush}"
                                         BorderThickness="1"
                                         CornerRadius="6"
                                         Padding="8,6"
                                         FontSize="12"
                                         Margin="0,0,0,6"
                                         KeyUp="OnParentFolderSearchKeyUp" />

                                <!-- List of matching folders -->
                                <ScrollViewer Grid.Row="1" MaxHeight="120">
                                    <StackPanel x:Name="ParentFolderItemsPanel" Spacing="2" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Click="OnCancelNewFolderClick"
                                Content="Cancel"
                                Background="Transparent"
                                Foreground="{Binding TextSecondaryBrush}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,6,0"
                                Height="38"
                                CornerRadius="8" />

                        <Button Grid.Column="1"
                                Click="OnConfirmNewFolderClick"
                                Content="Create"
                                Background="#2563eb"
                                Foreground="#ffffff"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                Margin="6,0,0,0"
                                Height="38"
                                CornerRadius="8" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 4: LEFT SIDEBAR / NAVIGATION DRAWER -->
        <Grid x:Name="LeftDrawerOverlay" IsVisible="False">
            <!-- Scrim / Dim Backdrop -->
            <Rectangle Fill="#80000000"
                       PointerPressed="OnCloseLeftDrawerClick" />

            <!-- Slide Drawer Body -->
            <Border HorizontalAlignment="Left"
                    Width="295"
                    Background="{Binding DrawerBackgroundBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="0,0,1,0"
                    BoxShadow="2 0 8 #25000000">
                <Grid RowDefinitions="Auto,*,Auto" Margin="0,14,0,14">
                    <!-- Drawer Header -->
                    <Border Grid.Row="0" Padding="16,12,16,14" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="0,0,0,1">
                        <Panel>
                            <!-- Normal Drawer Header -->
                            <Grid x:Name="DrawerNormalHeader" IsVisible="True" ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Background="{Binding FabBackgroundBrush}" CornerRadius="10" Width="36" Height="36">
                                        <PathIcon Data="{StaticResource IconBolt}" Width="20" Height="20" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="QuickNote" FontSize="18" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" />
                                        <TextBlock Text="Markdown Notes" FontSize="11" Foreground="{Binding TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Click="OnToggleThemeClick"
                                            Background="Transparent"
                                            Foreground="{Binding TextSecondaryBrush}"
                                            Padding="6"
                                            CornerRadius="16"
                                            ToolTip.Tip="Switch theme">
                                        <PathIcon Data="{Binding ThemeIconGeometry}" Width="16" Height="16" Foreground="{Binding TextSecondaryBrush}" />
                                    </Button>
                                    <Button Click="OnCloseLeftDrawerClick"
                                            Background="Transparent"
                                            Foreground="{Binding TextSecondaryBrush}"
                                            Padding="6"
                                            CornerRadius="16">
                                        <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" Foreground="{Binding TextSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Folder Selection Mode Drawer Header (Issue 1) -->
                            <Grid x:Name="DrawerFolderSelectionHeader" IsVisible="False" ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0"
                                        Click="OnCancelFolderSelectionClick"
                                        Background="Transparent"
                                        Foreground="{Binding TextPrimaryBrush}"
                                        Padding="6"
                                        VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" Foreground="{Binding TextPrimaryBrush}" />
                                </Button>
                                <TextBlock Grid.Column="1"
                                           x:Name="DrawerFolderSelectionCountText"
                                           Text="0 selected"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0" />
                                <Button Grid.Column="2"
                                        Click="OnToggleSelectAllFoldersClick"
                                        Background="{Binding ChipUnselectedBackgroundBrush}"
                                        BorderBrush="{Binding AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="DrawerFolderSelectAllBtnText" Text="All" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                                </Button>
                            </Grid>
                        </Panel>
                    </Border>

                    <!-- Scrollable Navigation Items -->
                    <ScrollViewer Grid.Row="1"
                                  Padding="12,12"
                                  IsScrollInertiaEnabled="True"
                                  IsScrollChainingEnabled="False">
                        <StackPanel Spacing="6">
                            <!-- All Notes Item -->
                            <Button Click="OnDrawerAllNotesClick"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="10,8"
                                    CornerRadius="10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconNotes}" Width="18" Height="18" Foreground="#3b82f6" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="All Notes" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{Binding ChipUnselectedBackgroundBrush}" CornerRadius="10" Padding="8,2">
                                        <TextBlock Text="{Binding TotalNotesCountText}" FontSize="11" Foreground="{Binding TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Trash Bin Item -->
                            <Button Click="OnDrawerTrashBinClick"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="10,8"
                                    CornerRadius="10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconTrash}" Width="18" Height="18" Foreground="#ef4444" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Trash Bin" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{Binding ChipUnselectedBackgroundBrush}" CornerRadius="10" Padding="8,2">
                                        <TextBlock x:Name="DrawerTrashBadgeText" Text="0" FontSize="11" Foreground="#ef4444" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Version History & Backups Item -->
                            <Button Click="OnDrawerVersionHistoryClick"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="10,8"
                                    CornerRadius="10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconHistory}" Width="18" Height="18" Foreground="{Binding AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Version History" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Width="14" Height="14" Foreground="{Binding TextMutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Folders Section Header with + Folder Button -->
                            <Grid ColumnDefinitions="*,Auto" Margin="10,16,6,4">
                                <TextBlock Grid.Column="0" Text="FOLDERS" FontSize="11" FontWeight="Bold" Foreground="{Binding TextMutedBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Click="OnDrawerNewFolderClick"
                                        Background="Transparent"
                                        Padding="4"
                                        ToolTip.Tip="Create new folder">
                                    <PathIcon Data="{StaticResource IconFolderPlus}" Width="16" Height="16" Foreground="{Binding AccentBrush}" />
                                </Button>
                            </Grid>

                            <!-- Dynamic Folder List -->
                            <StackPanel x:Name="DrawerFoldersPanel" Spacing="4" />

                            <!-- TAGS Section Header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="10,16,6,4">
                                <TextBlock Grid.Column="0" Text="TAGS" FontSize="11" FontWeight="Bold" Foreground="{Binding TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Dynamic Tag List -->
                            <StackPanel x:Name="DrawerTagsPanel" Spacing="4" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawer Footer: Normal vs Folder Selection Actions -->
                    <Border Grid.Row="2" Padding="14,10" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <!-- Normal Drawer Footer: Cloud Sync Status -->
                            <Button x:Name="DrawerNormalFooter"
                                    Click="OnOpenCloudSyncClick"
                                    Background="{Binding GlassSurfaceBrush}"
                                    BorderBrush="{Binding GlassBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="12,10"
                                    CornerRadius="12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconCloud}" Width="18" Height="18" Foreground="{Binding AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Google Drive" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ConnectedAccountEmail}" FontSize="11" Foreground="{Binding TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <PathIcon Grid.Column="2" Data="{StaticResource IconSync}" Width="14" Height="14" Foreground="#10b981" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Collapsible View Sync Logs (Issue 8) -->
                            <Button Click="OnToggleSyncLogsClick"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="10,6"
                                    CornerRadius="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconTerminal}" Width="14" Height="14" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="View Sync Logs" FontSize="12" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <PathIcon Grid.Column="2" x:Name="SyncLogsChevron" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Sync Logs Expandable Drawer Panel -->
                            <Border x:Name="SyncLogsContainer"
                                    IsVisible="False"
                                    Background="{Binding GlassSurfaceBrush}"
                                    BorderBrush="{Binding GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8"
                                    MaxHeight="140">
                                <ScrollViewer x:Name="SyncLogsScrollViewer">
                                    <TextBlock x:Name="SyncLogsText"
                                               Text="No sync activity recorded yet."
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               FontSize="10"
                                               Foreground="{Binding TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>

                            <!-- Folder Selection Actions: Move, Delete (Issue 1) -->
                            <Grid x:Name="DrawerFolderSelectionFooter" IsVisible="False" ColumnDefinitions="*,*">
                                <Button Grid.Column="0"
                                        Click="OnBatchMoveFoldersClick"
                                        Background="{Binding ChipUnselectedBackgroundBrush}"
                                        BorderBrush="{Binding GlassBorderBrush}"
                                        BorderThickness="1"
                                        Foreground="{Binding AccentBrush}"
                                        CornerRadius="10"
                                        Padding="10,8"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" Foreground="{Binding AccentBrush}" />
                                        <TextBlock Text="Move" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Click="OnBatchDeleteFoldersClick"
                                        Background="#28ef4444"
                                        BorderBrush="#50ef4444"
                                        BorderThickness="1"
                                        Foreground="#ef4444"
                                        CornerRadius="10"
                                        Padding="10,8"
                                        Margin="4,0,0,0"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconTrash}" Width="16" Height="16" Foreground="#ef4444" />
                                        <TextBlock Text="Delete" FontSize="12" FontWeight="SemiBold" Foreground="#ef4444" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- SCREEN 3: TRASH BIN SCREEN -->
        <Grid x:Name="TrashBinScreen" RowDefinitions="Auto,*" Background="{Binding AppBackgroundBrush}" IsVisible="False">
            <!-- Top App Bar with Inset -->
            <Border Grid.Row="0" Background="{Binding GlassHeaderBackgroundBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="12,14,12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Click="OnCloseTrashBinClick"
                            Background="Transparent"
                            Foreground="{Binding TextPrimaryBrush}"
                            Padding="8"
                            CornerRadius="20">
                        <PathIcon Data="{StaticResource IconBack}" Width="20" Height="20" Foreground="{Binding TextPrimaryBrush}" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="Trash Bin"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{Binding TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="OnRestoreAllTrashClick"
                                Background="#2563eb"
                                Foreground="#ffffff"
                                CornerRadius="8"
                                Padding="12,6"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Content="Restore All" />
                        <Button Click="OnPromptEmptyTrashClick"
                                Background="#ef4444"
                                Foreground="#ffffff"
                                CornerRadius="8"
                                Padding="12,6"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Content="Empty Trash" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Trash Bin Content -->
            <Grid Grid.Row="1">
                <ScrollViewer Padding="16,16">
                    <StackPanel x:Name="TrashItemsPanel" Spacing="10" />
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel x:Name="TrashEmptyState"
                            IsVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Margin="20">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{Binding GlassSurfaceBrush}" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconTrash}" Width="28" Height="28" Foreground="{Binding TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Trash is empty" FontSize="18" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Notes and folders moved to trash will appear here" FontSize="13" Foreground="{Binding TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- MODAL 5: CONFIRM DELETE FOLDER -->
        <Grid x:Name="ConfirmDeleteFolderModal" Background="#a0000000" IsVisible="False" PointerPressed="OnCancelDeleteFolderClick">
            <Border Background="{Binding ModalBackgroundBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Width="320" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20" PointerPressed="OnModalContentPointerPressed">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconTrash}" Width="22" Height="22" Foreground="#ef4444" />
                        <TextBlock Text="Delete Folder?" FontSize="18" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ConfirmDeleteFolderMessageText" Text="Delete this folder and move its notes to trash?"
                               FontSize="13" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Click="OnCancelDeleteFolderClick" Content="Cancel" Background="Transparent" Foreground="{Binding TextSecondaryBrush}" HorizontalAlignment="Stretch" Margin="0,0,6,0" Height="38" CornerRadius="8" />
                        <Button Grid.Column="1" Click="OnConfirmDeleteFolderClick" Content="Delete" Background="#ef4444" Foreground="#ffffff" FontWeight="SemiBold" HorizontalAlignment="Stretch" Margin="6,0,0,0" Height="38" CornerRadius="8" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 6: CONFIRM EMPTY TRASH -->
        <Grid x:Name="ConfirmEmptyTrashModal" Background="#a0000000" IsVisible="False" PointerPressed="OnCancelEmptyTrashClick">
            <Border Background="{Binding ModalBackgroundBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Width="320" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20" PointerPressed="OnModalContentPointerPressed">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconTrash}" Width="22" Height="22" Foreground="#ef4444" />
                        <TextBlock Text="Empty Trash Bin?" FontSize="18" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="All notes and folders in the trash bin will be permanently deleted. This cannot be undone."
                               FontSize="13" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Click="OnCancelEmptyTrashClick" Content="Cancel" Background="Transparent" Foreground="{Binding TextSecondaryBrush}" HorizontalAlignment="Stretch" Margin="0,0,6,0" Height="38" CornerRadius="8" />
                        <Button Grid.Column="1" Click="OnConfirmEmptyTrashClick" Content="Empty Trash" Background="#ef4444" Foreground="#ffffff" FontWeight="SemiBold" HorizontalAlignment="Stretch" Margin="6,0,0,0" Height="38" CornerRadius="8" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 7: MOVE NOTES DESTINATION PICKER (Issue 1) -->
        <Grid x:Name="MoveNotesModal" Background="#a0000000" IsVisible="False" PointerPressed="OnCancelMoveNotesClick">
            <Border Background="{Binding ModalBackgroundBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="320"
                    MaxHeight="450"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20"
                    BoxShadow="0 8 32 #50000000"
                    PointerPressed="OnModalContentPointerPressed">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconFolder}" Width="20" Height="20" Foreground="#3b82f6" />
                            <TextBlock x:Name="MoveNotesModalTitle" Text="Move Notes" FontSize="17" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCancelMoveNotesClick" Background="Transparent" Foreground="{Binding TextSecondaryBrush}" Padding="4">
                            <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- Search destination folders -->
                    <TextBox x:Name="MoveNotesSearchBox"
                             PlaceholderText="Search folder..."
                             Background="{Binding GlassSurfaceBrush}"
                             Foreground="{Binding TextPrimaryBrush}"
                             BorderBrush="{Binding GlassBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="10,8"
                             FontSize="13"
                             KeyUp="OnMoveNotesSearchKeyUp" />

                    <!-- Destination Folders List -->
                    <ScrollViewer MaxHeight="240">
                        <StackPanel x:Name="MoveNotesDestinationsPanel" Spacing="4" />
                    </ScrollViewer>

                    <Button Click="OnCancelMoveNotesClick"
                            Content="Cancel"
                            Background="Transparent"
                            Foreground="{Binding TextSecondaryBrush}"
                            HorizontalAlignment="Stretch"
                            Height="36"
                            CornerRadius="8" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 8: MOVE FOLDERS DESTINATION PICKER (Issue 1) -->
        <Grid x:Name="MoveFoldersModal" Background="#a0000000" IsVisible="False" PointerPressed="OnCancelMoveFoldersClick">
            <Border Background="{Binding ModalBackgroundBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="320"
                    MaxHeight="450"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20"
                    BoxShadow="0 8 32 #50000000"
                    PointerPressed="OnModalContentPointerPressed">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconFolder}" Width="20" Height="20" Foreground="#3b82f6" />
                            <TextBlock x:Name="MoveFoldersModalTitle" Text="Move Folders" FontSize="17" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCancelMoveFoldersClick" Background="Transparent" Foreground="{Binding TextSecondaryBrush}" Padding="4">
                            <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- Search destination folders -->
                    <TextBox x:Name="MoveFoldersSearchBox"
                             PlaceholderText="Search parent folder..."
                             Background="{Binding GlassSurfaceBrush}"
                             Foreground="{Binding TextPrimaryBrush}"
                             BorderBrush="{Binding GlassBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="8"
                             Padding="10,8"
                             FontSize="13"
                             KeyUp="OnMoveFoldersSearchKeyUp" />

                    <!-- Destination Folders List -->
                    <ScrollViewer MaxHeight="240">
                        <StackPanel x:Name="MoveFoldersDestinationsPanel" Spacing="4" />
                    </ScrollViewer>

                    <Button Click="OnCancelMoveFoldersClick"
                            Content="Cancel"
                            Background="Transparent"
                            Foreground="{Binding TextSecondaryBrush}"
                            HorizontalAlignment="Stretch"
                            Height="36"
                            CornerRadius="8" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 9: CONFIRM BATCH DELETE FOLDERS (Issue 1) -->
        <Grid x:Name="ConfirmBatchDeleteFoldersModal" Background="#a0000000" IsVisible="False" PointerPressed="OnCancelBatchDeleteFoldersClick">
            <Border Background="{Binding ModalBackgroundBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Width="320" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20" PointerPressed="OnModalContentPointerPressed">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconTrash}" Width="22" Height="22" Foreground="#ef4444" />
                        <TextBlock Text="Delete Folders?" FontSize="18" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ConfirmBatchDeleteFoldersMessageText" Text="Delete selected folders and move their notes to the Trash Bin?"
                               FontSize="13" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Click="OnCancelBatchDeleteFoldersClick" Content="Cancel" Background="Transparent" Foreground="{Binding TextSecondaryBrush}" HorizontalAlignment="Stretch" Margin="0,0,6,0" Height="38" CornerRadius="8" />
                        <Button Grid.Column="1" Click="OnConfirmBatchDeleteFoldersClick" Content="Delete" Background="#ef4444" Foreground="#ffffff" FontWeight="SemiBold" HorizontalAlignment="Stretch" Margin="6,0,0,0" Height="38" CornerRadius="8" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 10: NOTE EDITOR 3-DOTS MORE MENU (Modern Mobile Action Sheet) -->
        <Grid x:Name="NoteEditorMenuModal" Background="#70000000" IsVisible="False" PointerPressed="OnCloseNoteEditorMenuClick">
            <Border Background="{Binding ModalBackgroundBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="24,24,0,0"
                    MaxWidth="450"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Padding="20,12,20,28"
                    BoxShadow="0 -8 32 #50000000"
                    PointerPressed="OnMenuModalContentPointerPressed">
                <StackPanel Spacing="10">
                    <!-- Sheet Drag Handle -->
                    <Border Width="36" Height="4" CornerRadius="2" Background="{Binding TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5" />

                    <!-- Sheet Header -->
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,2,6">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Note Options" FontSize="16" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ActiveNoteTitle}" FontSize="12" Foreground="{Binding TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCloseNoteEditorMenuClick" Background="Transparent" Foreground="{Binding TextSecondaryBrush}" Padding="6" CornerRadius="16">
                            <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" Foreground="{Binding TextSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Duplicate Note Option -->
                    <Button Click="OnEditorCopyNoteClick"
                            Background="{Binding GlassSurfaceBrush}"
                            BorderBrush="{Binding GlassBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="14,12"
                            CornerRadius="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1a3b82f6" Margin="0,0,12,0">
                                <PathIcon Data="{StaticResource IconCopy}" Width="18" Height="18" Foreground="#3b82f6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Duplicate Note" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" />
                                <TextBlock Text="Create an exact copy in the same folder" FontSize="11" Foreground="{Binding TextSecondaryBrush}" />
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Width="12" Height="12" Foreground="{Binding TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Move Note Option -->
                    <Button Click="OnEditorMoveNoteClick"
                            Background="{Binding GlassSurfaceBrush}"
                            BorderBrush="{Binding GlassBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="14,12"
                            CornerRadius="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1af59e0b" Margin="0,0,12,0">
                                <PathIcon Data="{StaticResource IconFolder}" Width="18" Height="18" Foreground="#f59e0b" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Move Note..." FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" />
                                <TextBlock Text="Organize into another folder or root" FontSize="11" Foreground="{Binding TextSecondaryBrush}" />
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Width="12" Height="12" Foreground="{Binding TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Version History Option -->
                    <Button Click="OnEditorVersionHistoryClick"
                            Background="{Binding GlassSurfaceBrush}"
                            BorderBrush="{Binding GlassBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="14,12"
                            CornerRadius="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1a8b5cf6" Margin="0,0,12,0">
                                <PathIcon Data="{StaticResource IconHistory}" Width="18" Height="18" Foreground="#8b5cf6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Version History..." FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" />
                                <TextBlock Text="Inspect and restore previous revisions" FontSize="11" Foreground="{Binding TextSecondaryBrush}" />
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Width="12" Height="12" Foreground="{Binding TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Settings & Theme Option -->
                    <Button Click="OnEditorOpenSettingsClick"
                            Background="{Binding GlassSurfaceBrush}"
                            BorderBrush="{Binding GlassBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="14,12"
                            CornerRadius="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1a10b981" Margin="0,0,12,0">
                                <PathIcon Data="{StaticResource IconSettings}" Width="18" Height="18" Foreground="#10b981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Settings &amp; Theme" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" />
                                <TextBlock Text="Editor appearance, font and themes" FontSize="11" Foreground="{Binding TextSecondaryBrush}" />
                            </StackPanel>
                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Width="12" Height="12" Foreground="{Binding TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Rectangle Height="1" Fill="{Binding GlassBorderBrush}" Margin="0,2" />

                    <!-- Delete Note Option (Destructive) -->
                    <Button Click="OnEditorDeleteNoteClick"
                            Background="#18ef4444"
                            BorderBrush="#40ef4444"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="14,12"
                            CornerRadius="12">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#26ef4444" Margin="0,0,12,0">
                                <PathIcon Data="{StaticResource IconTrash}" Width="18" Height="18" Foreground="#ef4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Delete Note" FontSize="14" FontWeight="Bold" Foreground="#ef4444" />
                                <TextBlock Text="Move note to Trash Bin" FontSize="11" Foreground="#f87171" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    

        <!-- MODAL 11: SETTINGS, THEMES & DICTIONARY MODAL -->
        <Grid x:Name="SettingsModal" Background="#70000000" IsVisible="False" PointerPressed="OnCloseSettingsModalClick">
            <Border Background="{Binding ModalBackgroundBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="360"
                    MaxHeight="620"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="16"
                    BoxShadow="0 12 36 #50000000"
                    PointerPressed="OnSettingsModalContentPointerPressed">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Header (Row 0) -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconSettings}" Width="18" Height="18" Foreground="{Binding AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Settings &amp; Preferences" FontSize="16" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Click="OnCloseSettingsModalClick" Background="Transparent" Padding="4" CornerRadius="12">
                            <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" Foreground="{Binding TextSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Segmented Tabs (Row 1): Themes | Dictionary -->
                    <Border Grid.Row="1" Background="{Binding GlassSurfaceBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,*">
                            <Border Grid.Column="0" Background="{Binding ThemeTabBackgroundBrush}" CornerRadius="8" Padding="0,6" Cursor="Hand" Tapped="OnSettingsTabThemesClick">
                                <TextBlock Text="Themes" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ThemeTabForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Background="{Binding DictionaryTabBackgroundBrush}" CornerRadius="8" Padding="0,6" Cursor="Hand" Tapped="OnSettingsTabDictionaryClick">
                                <TextBlock Text="Dictionary" FontSize="13" FontWeight="SemiBold" Foreground="{Binding DictionaryTabForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Tab Content (Row 2) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- TAB 1: THEMES PANEL -->
                            <StackPanel x:Name="SettingsThemesPanel" Spacing="14" IsVisible="True">
                                <!-- Theme Style Section -->
                                <TextBlock Text="THEME STYLE" FontSize="11" FontWeight="Bold" Foreground="{Binding TextMutedBrush}" LetterSpacing="0.8" />

                                <!-- Android Theme Card (Liquid Glass) -->
                                <Border x:Name="AndroidThemeCard"
                                        Background="{Binding GlassSurfaceBrush}"
                                        BorderBrush="{Binding AndroidCardBorderBrush}"
                                        BorderThickness="{Binding AndroidCardBorderThickness}"
                                        CornerRadius="14"
                                        Padding="12,10"
                                        Cursor="Hand"
                                        Tapped="OnSelectAndroidThemeClick">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Preview Circle -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#0b0e14" BorderBrush="#3390ec" BorderThickness="2" Margin="0,0,12,0">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#3390ec" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Android Theme" FontSize="14" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" />
                                            <TextBlock Text="Telegram Liquid Glass with electric blue" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Active Check -->
                                        <PathIcon Grid.Column="2" Data="{StaticResource IconCheckCircle}" Width="18" Height="18" Foreground="{Binding AccentBrush}" IsVisible="{Binding IsAndroidThemeActive}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Windows App Theme Card (Obsidian Slate) -->
                                <Border x:Name="WindowsThemeCard"
                                        Background="{Binding GlassSurfaceBrush}"
                                        BorderBrush="{Binding WindowsCardBorderBrush}"
                                        BorderThickness="{Binding WindowsCardBorderThickness}"
                                        CornerRadius="14"
                                        Padding="12,10"
                                        Cursor="Hand"
                                        Tapped="OnSelectWindowsThemeClick">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Preview Circle -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#11141c" BorderBrush="#2563eb" BorderThickness="2" Margin="0,0,12,0">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="#2563eb" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Windows App Theme" FontSize="14" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" />
                                            <TextBlock Text="Classic dark slate &amp; cobalt blue from Desktop" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Active Check -->
                                        <PathIcon Grid.Column="2" Data="{StaticResource IconCheckCircle}" Width="18" Height="18" Foreground="{Binding AccentBrush}" IsVisible="{Binding IsWindowsThemeActive}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Custom Imported Theme Button -->
                                <Border Background="{Binding GlassSurfaceBrush}"
                                        BorderBrush="{Binding GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12,10"
                                        Cursor="Hand"
                                        Tapped="OnImportThemeClick">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <PathIcon Grid.Column="0" Data="{StaticResource IconPalette}" Width="18" Height="18" Foreground="{Binding AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Import Theme (JSON)..." FontSize="14" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" />
                                            <TextBlock Text="Load custom color schema from config file" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}" Width="14" Height="14" Foreground="{Binding TextMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Editor Consistency Notice -->
                                <Border Background="{Binding ChipUnselectedBackgroundBrush}" CornerRadius="10" Padding="10,8">
                                    <TextBlock Text="Changing theme updates note list, cards, dialogs, and the text editor background seamlessly."
                                               FontSize="11" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>

                                <!-- Mode Switch: Dark / Light -->
                                <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="Bold" Foreground="{Binding TextMutedBrush}" LetterSpacing="0.8" Margin="0,6,0,0" />
                                <Border Background="{Binding GlassSurfaceBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ThemeToggleText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" />
                                            <TextBlock Text="Toggle Dark / Light canvas" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                                                      OnContent="Dark"
                                                      OffContent="Light"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- TAB 2: DICTIONARY PANEL (Matching ss4) -->
                            <StackPanel x:Name="SettingsDictionaryPanel" Spacing="14" IsVisible="False">
                                <!-- Spell Check Card (Matching ss4) -->
                                <Border Background="{Binding GlassSurfaceBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,10,0">
                                            <TextBlock Text="Editor Spell Check" FontSize="14" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" />
                                            <TextBlock Text="Show red wavy squiggles for misspelled words. Turn off to avoid underlines on technical terms (WinRM, LDAPS, PowerShell)."
                                                       FontSize="11"
                                                       Foreground="{Binding TextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding IsSpellCheckEnabled, Mode=TwoWay}"
                                                      OnContent="Enabled"
                                                      OffContent="Disabled"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Add Word Input Row (Matching ss4) -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="TxtAddIgnoredWord"
                                             Grid.Column="0"
                                             PlaceholderText="Add word or technical term (e.g. WinRM, ldaps, kubectl)..."
                                             Background="{Binding GlassSurfaceBrush}"
                                             BorderBrush="{Binding GlassBorderBrush}"
                                             BorderThickness="1"
                                             CornerRadius="12"
                                             Padding="12,9"
                                             Foreground="{Binding TextPrimaryBrush}"
                                             FontSize="13"
                                             Margin="0,0,8,0"
                                             KeyDown="OnAddIgnoredWordKeyDown" />
                                    <Button Grid.Column="1"
                                            Click="OnAddIgnoredWordClick"
                                            Background="{Binding AccentBrush}"
                                            Foreground="#ffffff"
                                            CornerRadius="12"
                                            Padding="14,9"
                                            FontWeight="SemiBold"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" Foreground="#ffffff" />
                                            <TextBlock Text="Add" FontSize="13" Foreground="#ffffff" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Custom Ignored Words Chips Section (Matching ss4) -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="CUSTOM IGNORED WORDS" FontSize="11" FontWeight="Bold" Foreground="{Binding TextMutedBrush}" LetterSpacing="0.8" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding IgnoredWordsCountText}" FontSize="11" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- WrapPanel Chips Container -->
                                <Border Background="{Binding GlassSurfaceBrush}" BorderBrush="{Binding GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10" MinHeight="100" MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <WrapPanel x:Name="IgnoredWordsChipsPanel" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer: Close Button -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Button Click="OnCloseSettingsModalClick"
                                Content="Close"
                                Background="{Binding AccentBrush}"
                                Foreground="#ffffff"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                Padding="24,8"
                                CornerRadius="10" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

<!-- MODAL 12: BACKUP & VERSION HISTORY MODAL (Telegram Liquid Glass Style) -->
        <Grid x:Name="VersionHistoryModal" Background="#70000000" IsVisible="False" PointerPressed="OnCloseVersionHistoryClick">
            <Border Background="{Binding ModalBackgroundBrush}"
                    BorderBrush="{Binding GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    MaxWidth="520"
                    MaxHeight="680"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Margin="16"
                    Padding="16"
                    BoxShadow="0 16 48 #60000000"
                    PointerPressed="OnVersionHistoryModalContentPointerPressed">
                <Grid RowDefinitions="Auto,*">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconHistory}" Width="18" Height="18" Foreground="{Binding AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Version History" FontSize="17" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />

                        <!-- Snapshot active note button -->
                        <Button Grid.Column="2" Click="OnCreateManualSnapshotClick"
                                Background="{Binding GlassSurfaceBrush}"
                                BorderBrush="{Binding GlassBorderBrush}"
                                BorderThickness="1"
                                Padding="8,5"
                                CornerRadius="8"
                                Margin="0,0,8,0"
                                ToolTip.Tip="Take a snapshot of current note">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource IconSave}" Width="12" Height="12" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Snapshot" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Click="OnCloseVersionHistoryClick" Background="Transparent" Padding="4" CornerRadius="12">
                            <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" Foreground="{Binding TextSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Content Container -->
                    <Grid Grid.Row="1">
                        <!-- VIEW A: Backups Note Files List -->
                        <Grid x:Name="BackupFilesViewContainer" RowDefinitions="Auto,*" IsVisible="True">
                            <!-- Search Bar -->
                            <Border Grid.Row="0"
                                    Background="{Binding GlassSurfaceBrush}"
                                    BorderBrush="{Binding GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,4"
                                    Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconSearch}" Width="14" Height="14" Foreground="{Binding TextSecondaryBrush}" Margin="2,0,8,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             x:Name="BackupSearchBox"
                                             PlaceholderText="Search note files..."
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{Binding TextPrimaryBrush}"
                                             FontSize="13"
                                             TextChanged="OnBackupSearchTextChanged" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="BackupNotesEmptyText"
                                               Text="No backup versions found"
                                               FontSize="13"
                                               Foreground="{Binding TextSecondaryBrush}"
                                               FontStyle="Italic"
                                               HorizontalAlignment="Center"
                                               Margin="0,24,0,0"
                                               IsVisible="False" />
                                    <StackPanel x:Name="BackupNotesListPanel" Spacing="4" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- VIEW B: Note Versions & Content Preview -->
                        <Grid x:Name="BackupVersionsViewContainer" RowDefinitions="Auto,*,Auto" IsVisible="False">
                            <!-- Breadcrumb Header -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                                <Button Grid.Column="0" Click="OnBackupBackToFilesClick"
                                        Background="{Binding GlassSurfaceBrush}"
                                        BorderBrush="{Binding GlassBorderBrush}"
                                        BorderThickness="1"
                                        Padding="8,5"
                                        CornerRadius="8"
                                        Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource IconChevronLeft}" Width="12" Height="12" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Files" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="BackupDetailNoteTitle" Text="Note Revisions" FontSize="14" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="BackupDetailNotePath" Text="" FontSize="11" Foreground="{Binding TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <!-- Middle: Versions List & Content Preview -->
                            <Grid Grid.Row="1" RowDefinitions="140,*">
                                <!-- Revisions List -->
                                <Border Grid.Row="0"
                                        Background="{Binding GlassSurfaceBrush}"
                                        BorderBrush="{Binding GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6"
                                        Margin="0,0,0,8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="BackupVersionsListPanel" Spacing="4" />
                                    </ScrollViewer>
                                </Border>

                                <!-- Preview Pane -->
                                <Border Grid.Row="1"
                                        x:Name="BackupDetailViewContainer"
                                        Background="{Binding GlassSurfaceBrush}"
                                        BorderBrush="{Binding GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Grid.Row="0"
                                                   x:Name="BackupPreviewMetaText"
                                                   Text="Snapshot Preview"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TextSecondaryBrush}"
                                                   Margin="0,0,0,6" />
                                        <TextBox Grid.Row="1"
                                                 x:Name="BackupPreviewTextBox"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{Binding TextPrimaryBrush}"
                                                 FontSize="12" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Bottom Action Bar -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
                                <Button Grid.Column="1" Click="OnCopyVersionTextClick"
                                        Content="Copy Text"
                                        Background="{Binding GlassSurfaceBrush}"
                                        BorderBrush="{Binding GlassBorderBrush}"
                                        BorderThickness="1"
                                        Foreground="{Binding TextPrimaryBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Padding="14,8"
                                        CornerRadius="10"
                                        Margin="0,0,8,0" />
                                <Button Grid.Column="2" Click="OnRestoreVersionClick"
                                        Content="Restore Version"
                                        Background="{Binding AccentBrush}"
                                        Foreground="#ffffff"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Padding="16,8"
                                        CornerRadius="10" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
