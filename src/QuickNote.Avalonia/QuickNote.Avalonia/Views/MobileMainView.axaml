<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuickNote.Avalonia.ViewModels"
             xmlns:views="using:QuickNote.Avalonia.Views"
             xmlns:notion="using:QuickNote.Avalonia.Notion"
             xmlns:controls="using:Avalonia.Controls"
             x:Class="QuickNote.Avalonia.Views.MobileMainView"
             x:Name="Root"
             x:DataType="views:MobileMainView"
             Background="#121214">

    <UserControl.Resources>
        <!-- Material Design Icons -->
        <StreamGeometry x:Key="IconBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconPlus">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
        <StreamGeometry x:Key="IconCloud">M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconFolderPlus">M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z</StreamGeometry>
        <StreamGeometry x:Key="IconDocument">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
        <StreamGeometry x:Key="IconBolt">M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-5.97 10.49z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
        <StreamGeometry x:Key="IconSync">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</StreamGeometry>
    </UserControl.Resources>

    <Grid>
        <!-- SCREEN 1: NATIVE ANDROID NOTES FEED -->
        <Grid x:Name="NotesFeedScreen" RowDefinitions="Auto,Auto,*,Auto" Background="#121214" IsVisible="True">
            <!-- Android Status Bar Safe Inset & Search Capsule -->
            <Border Grid.Row="0" Background="#121214" Padding="16,36,16,10">
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Top Bar: App Title + Sync Pill -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconBolt}" Width="20" Height="20" Foreground="#3b82f6" />
                            <TextBlock Text="QuickNote" FontSize="20" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Cloud Sync Badge -->
                        <Border Grid.Column="2"
                                x:Name="CloudSyncBadge"
                                Background="#1e1e24"
                                CornerRadius="16"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Tapped="OnCloudSyncBadgeTapped">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconCloud}" Width="13" Height="13" Foreground="#10b981" />
                                <TextBlock Text="{Binding CloudSyncStatusText}" FontSize="12" Foreground="#9ca3af" VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Google-style Rounded Search Pill -->
                    <Border Grid.Row="1"
                            Background="#1e1e24"
                            BorderBrush="#2c2c34"
                            BorderThickness="1"
                            CornerRadius="24"
                            Height="46"
                            Padding="12,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconSearch}" Width="18" Height="18" Foreground="#6b7280" Margin="4,0,8,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     x:Name="SearchBox"
                                     Text="{Binding SearchQuery, Mode=TwoWay}"
                                     PlaceholderText="Search notes..."
                                     Background="Transparent"
                                     Foreground="#ffffff"
                                     BorderThickness="0"
                                     FontSize="14"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Click="OnClearSearchClick"
                                    Background="Transparent"
                                    Foreground="#9ca3af"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasSearchQuery}">
                                <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Category / Folder Filter Chips (Horizontal Scroll) -->
            <Border Grid.Row="1" Background="#121214" Padding="16,4,16,8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Spacing="8">
                        <!-- Chips populated dynamically in code-behind -->
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Notes Card Feed -->
            <Grid Grid.Row="2">
                <!-- List of Note Cards -->
                <ScrollViewer x:Name="NotesScrollViewer" Padding="16,6,16,80">
                    <ItemsControl ItemsSource="{Binding FilteredNotes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:MobileNoteItem">
                                <Border Margin="0,0,0,10"
                                        CornerRadius="14"
                                        Background="#1c1c20"
                                        BorderBrush="#292930"
                                        BorderThickness="1"
                                        Padding="16,14"
                                        Tapped="OnNoteCardTapped">
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <!-- Row 1: Title + Folder Badge -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#ffffff"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Background="#26262e"
                                                    CornerRadius="10"
                                                    Padding="8,3"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding FolderName}" FontSize="11" Foreground="#9ca3af" />
                                            </Border>
                                        </Grid>

                                        <!-- Row 2: Snippet / Preview -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Snippet}"
                                                   FontSize="13"
                                                   Foreground="#9ca3af"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2"
                                                   Margin="0,6,0,8" />

                                        <!-- Row 3: Timestamp & Delete Action -->
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FormattedDate}"
                                                       FontSize="11"
                                                       Foreground="#6b7280"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Click="OnDeleteNoteCardClick"
                                                    Background="Transparent"
                                                    Foreground="#ef4444"
                                                    Padding="6"
                                                    VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="#ef4444" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State (When no notes match) -->
                <StackPanel IsVisible="{Binding IsNotesEmpty}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Margin="20">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#1e1e24" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconDocument}" Width="28" Height="28" Foreground="#3b82f6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No notes here yet" FontSize="18" FontWeight="SemiBold" Foreground="#f3f4f6" HorizontalAlignment="Center" />
                    <TextBlock Text="Tap the + button below to create your first note" FontSize="13" Foreground="#9ca3af" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <!-- Material 3 Floating Action Button (FAB) -->
                <Button Click="OnFabNewNoteClick"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,20,24"
                        Width="58"
                        Height="58"
                        CornerRadius="29"
                        Background="#2563eb"
                        BorderThickness="0">
                    <PathIcon Data="{StaticResource IconPlus}" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Bottom Android Bar (Status & Sync) -->
            <Border Grid.Row="3" Background="#161618" BorderBrush="#26262a" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding NoteCountStatus}"
                               FontSize="12"
                               Foreground="#9ca3af"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Click="OnSyncClick"
                            Background="#222228"
                            Foreground="#3b82f6"
                            Padding="12,6"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconSync}" Width="13" Height="13" Foreground="#3b82f6" />
                            <TextBlock Text="Sync" FontSize="12" FontWeight="SemiBold" Foreground="#3b82f6" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- SCREEN 2: NATIVE ANDROID NOTE EDITOR -->
        <Grid x:Name="NoteEditorScreen" RowDefinitions="Auto,*,Auto" Background="#141414" IsVisible="False">
            <!-- Top Editor App Bar with Safe Inset -->
            <Border Grid.Row="0" Background="#18181a" BorderBrush="#26262a" BorderThickness="0,0,0,1" Padding="8,36,12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Back Arrow (Returns to Notes Feed) -->
                    <Button Grid.Column="0"
                            Click="OnEditorBackClick"
                            Background="Transparent"
                            Foreground="#ffffff"
                            Padding="10"
                            CornerRadius="20"
                            VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconBack}" Width="22" Height="22" Foreground="#ffffff" />
                    </Button>

                    <!-- Editable Note Title -->
                    <TextBox Grid.Column="1"
                             x:Name="NoteTitleTextBox"
                             Text="{Binding ActiveNoteTitle, Mode=TwoWay}"
                             PlaceholderText="Note Title"
                             FontSize="18"
                             FontWeight="Bold"
                             Foreground="#ffffff"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Margin="4,0" />

                    <!-- Top Action Icons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Click="OnDeleteCurrentNoteClick"
                                Background="Transparent"
                                Foreground="#ef4444"
                                Padding="8"
                                CornerRadius="8">
                            <PathIcon Data="{StaticResource IconTrash}" Width="18" Height="18" Foreground="#ef4444" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Full-Screen Milkdown WYSIWYG Markdown Canvas -->
            <notion:NotionEditorControl x:Name="MobileNotionEditor"
                                        Grid.Row="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />

            <!-- Material Mobile Formatting Toolbar (Floats above soft keyboard) -->
            <Border Grid.Row="2"
                    Background="#18181a"
                    BorderBrush="#26262a"
                    BorderThickness="0,1,0,0"
                    Height="48"
                    Padding="6,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Click="OnFormatH1Click" Content="H1" FontWeight="Bold" Width="40" Height="36" CornerRadius="8" Background="#26262e" Foreground="#ffffff" />
                        <Button Click="OnFormatH2Click" Content="H2" FontWeight="Bold" Width="40" Height="36" CornerRadius="8" Background="#26262e" Foreground="#ffffff" />
                        <Button Click="OnFormatBoldClick" Content="B" FontWeight="Bold" Width="38" Height="36" CornerRadius="8" Background="#26262e" Foreground="#ffffff" />
                        <Button Click="OnFormatItalicClick" Content="I" FontStyle="Italic" Width="38" Height="36" CornerRadius="8" Background="#26262e" Foreground="#ffffff" />
                        <Button Click="OnFormatBulletClick" Content="• List" FontSize="12" Height="36" CornerRadius="8" Background="#26262e" Foreground="#ffffff" Padding="10,0" />
                        <Button Click="OnFormatNumberedClick" Content="1. List" FontSize="12" Height="36" CornerRadius="8" Background="#26262e" Foreground="#ffffff" Padding="10,0" />
                        <Button Click="OnFormatTodoClick" Content="☑ Todo" FontSize="12" Height="36" CornerRadius="8" Background="#26262e" Foreground="#ffffff" Padding="10,0" />
                        <Button Click="OnFormatCodeClick" Content="&lt;/&gt;" FontSize="12" Width="42" Height="36" CornerRadius="8" Background="#26262e" Foreground="#ffffff" />
                        <Button Click="OnFormatQuoteClick" Content="&quot; Quote" FontSize="12" Height="36" CornerRadius="8" Background="#26262e" Foreground="#ffffff" Padding="10,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MODAL 1: ONEDRIVE ACCOUNT & SYNC DETAILS -->
        <Grid x:Name="OneDriveAccountModal" Background="#a0000000" IsVisible="False">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#1c1c22" BorderBrush="#2f2f3a" BorderThickness="1"
                    CornerRadius="18" Padding="20" Width="340">
                <StackPanel Spacing="16">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconCloud}" Width="20" Height="20" Foreground="#3b82f6" />
                            <TextBlock Text="OneDrive Cloud Sync" FontSize="16" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="OnCloseAccountModalClick" Background="Transparent" Foreground="#9ca3af" Padding="4">
                            <PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- Account Info Body -->
                    <Border Background="#141418" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="Account:" FontSize="13" Foreground="#6b7280" Width="70" />
                                <TextBlock Grid.Column="1" Text="{Binding ConnectedAccountEmail, ElementName=Root}" FontSize="13" Foreground="#ffffff" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="Status:" FontSize="13" Foreground="#6b7280" Width="70" />
                                <TextBlock Grid.Column="1" Text="{Binding CloudSyncStatusText, ElementName=Root}" FontSize="13" Foreground="#10b981" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="Last Sync:" FontSize="13" Foreground="#6b7280" Width="70" />
                                <TextBlock Grid.Column="1" Text="{Binding LastSyncTimeText, ElementName=Root}" FontSize="13" Foreground="#9ca3af" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Spacing="10">
                        <!-- If Not Connected -->
                        <Button x:Name="BtnConnectOneDrive" Click="OnConnectOneDriveClick"
                                Background="#2563eb" Foreground="White" FontWeight="SemiBold"
                                CornerRadius="10" Height="42" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconCloud}" Width="16" Height="16" Foreground="White" />
                                <TextBlock Text="Sign in with Microsoft" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- If Connected -->
                        <Button x:Name="BtnSyncNow" Click="OnSyncNowClick"
                                Background="#10b981" Foreground="White" FontWeight="SemiBold"
                                CornerRadius="10" Height="42" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconSync}" Width="15" Height="15" Foreground="White" />
                                <TextBlock Text="Sync with Cloud Now" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDisconnectOneDrive" Click="OnDisconnectOneDriveClick"
                                Background="Transparent" BorderBrush="#3f3f46" BorderThickness="1"
                                Foreground="#ef4444" CornerRadius="10" Height="38"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <TextBlock Text="Disconnect Account" VerticalAlignment="Center" FontSize="13" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 2: IN-APP MICROSOFT LOGIN WEBVIEW -->
        <Grid x:Name="OneDriveAuthModal" RowDefinitions="Auto,*" Background="#121214" IsVisible="False">
            <!-- Header with Safe Padding -->
            <Border Grid.Row="0" Background="#18181a" BorderBrush="#26262a" BorderThickness="0,0,0,1" Padding="16,36,16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconCloud}" Width="18" Height="18" Foreground="#3b82f6" />
                        <TextBlock Text="Sign in to Microsoft" FontSize="16" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="OnCloseAuthModalClick" Background="Transparent" Foreground="#9ca3af" Padding="6">
                        <PathIcon Data="{StaticResource IconClose}" Width="18" Height="18" />
                    </Button>
                </Grid>
            </Border>

            <!-- Microsoft Login WebView -->
            <controls:NativeWebView x:Name="AuthWebView" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
