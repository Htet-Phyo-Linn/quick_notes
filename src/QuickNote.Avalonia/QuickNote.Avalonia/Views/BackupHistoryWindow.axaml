<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickNote.Avalonia.ViewModels"
        xmlns:models="using:QuickNote.Core.Models"
        x:Class="QuickNote.Avalonia.Views.BackupHistoryWindow"
        x:DataType="vm:BackupHistoryViewModel"
        Title="Version History &amp; Backups"
        Width="920" Height="620"
        MinWidth="750" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#18181b"
        CanResize="True">

    <Window.Resources>
        <StreamGeometry x:Key="IconHistory">M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.896 8.896 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z</StreamGeometry>
        <StreamGeometry x:Key="IconRestore">M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.2 3.16-1.98 5.12-1.98 3.89 0 7.14 2.78 7.84 6.43l2.44-.81C21.6 12.35 17.5 8 12.5 8z</StreamGeometry>
        <StreamGeometry x:Key="IconDocument">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
        <StreamGeometry x:Key="IconCamera">M12 12c1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3 1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-1.5c0-2.33-4.67-3.5-7-3.5z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <!-- TOP HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,14" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconHistory}" Width="18" Height="18" Foreground="#38bdf8" VerticalAlignment="Center" />
                    <TextBlock Text="Version History &amp; Backups" FontWeight="Bold" FontSize="17" Foreground="#f8fafc" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Search, inspect, and safely restore timestamped pre-save snapshots from disk." Foreground="#94a3b8" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Actions: Snapshot Now & Refresh -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding CreateManualSnapshotCommand}"
                        Background="#0369a1" Foreground="#f0f9ff"
                        BorderBrush="#0284c7" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" Cursor="Hand"
                        ToolTip.Tip="Save an instant manual snapshot of current note">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconHistory}" Width="13" Height="13" Foreground="#f0f9ff" VerticalAlignment="Center"/>
                        <TextBlock Text="Snapshot Active Note" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding RefreshCommand}"
                        Background="#27272a" Foreground="#e2e8f0"
                        BorderBrush="#3f3f46" BorderThickness="1"
                        CornerRadius="6" Padding="8,6" Cursor="Hand"
                        ToolTip.Tip="Reload version history from disk">
                    <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" Foreground="#94a3b8" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 3-PANE MASTER-DETAIL CONTAINER -->
        <Grid Grid.Row="1" ColumnDefinitions="260,280,*">
            <!-- PANE 1: NOTES LIST & SEARCH (Left) -->
            <Border Grid.Column="0" Background="#1e1e24" CornerRadius="8" BorderBrush="#2d2d38" BorderThickness="1" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto,*">
                    <!-- Search Box -->
                    <Grid Grid.Row="0" Margin="10,10,10,8">
                        <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" Foreground="#64748b" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="Search note title..."
                                 Background="#141418" Foreground="#f1f5f9"
                                 BorderBrush="#334155" BorderThickness="1"
                                 CornerRadius="6" Padding="28,5,8,5" Height="30" FontSize="12"/>
                    </Grid>

                    <!-- Notes ListBox -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredGroups}"
                             SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:NoteBackupGroup">
                                <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NoteTitle}" FontWeight="SemiBold" FontSize="13" Foreground="#e2e8f0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LatestTimestampText}" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#334155" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VersionCount}" FontSize="11" Foreground="#cbd5e1" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- PANE 2: REVISION TIMELINE (Middle) -->
            <Border Grid.Column="1" Background="#1e1e24" CornerRadius="8" BorderBrush="#2d2d38" BorderThickness="1" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" BorderBrush="#2d2d38" BorderThickness="0,0,0,1" Padding="12,10">
                        <TextBlock Text="REVISION TIMELINE" FontWeight="Bold" FontSize="11" Foreground="#94a3b8" LetterSpacing="0.8"/>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:NoteBackupVersion">
                                <Grid RowDefinitions="Auto,Auto" Margin="4,3">
                                    <!-- Date & Type Badge -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedDateTime}" FontSize="12" FontWeight="SemiBold" Foreground="#f8fafc" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Background="#1e293b" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="{Binding TypeBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#38bdf8"/>
                                        </Border>
                                    </Grid>
                                    <!-- Relative Age & Size -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding RelativeTimeText}" FontSize="11" Foreground="#94a3b8"/>
                                        <TextBlock Text="•" FontSize="11" Foreground="#64748b"/>
                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="#94a3b8"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- PANE 3: SNAPSHOT PREVIEW & RESTORE (Right) -->
            <Border Grid.Column="2" Background="#141418" CornerRadius="8" BorderBrush="#2d2d38" BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Preview Title Header -->
                    <Border Grid.Row="0" BorderBrush="#27272a" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedGroup.NoteTitle, FallbackValue='No Note Selected'}" FontWeight="Bold" FontSize="14" Foreground="#f8fafc" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedVersion.FormattedDateTime, FallbackValue='Select a snapshot version to inspect content'}" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CopyPreviewCommand}"
                                    IsEnabled="{Binding HasSelectedVersion}"
                                    Background="#27272a" Foreground="#cbd5e1"
                                    BorderBrush="#3f3f46" BorderThickness="1"
                                    CornerRadius="5" Padding="8,4" FontSize="11" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{StaticResource IconCopy}" Width="11" Height="11" Foreground="#94a3b8"/>
                                    <TextBlock Text="Copy Text"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Text Preview Area -->
                    <TextBox Grid.Row="1" Text="{Binding PreviewContent}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontFamily="Consolas, Cascadia Code, Menlo, Courier New"
                             FontSize="12"
                             Background="Transparent"
                             Foreground="#e2e8f0"
                             BorderThickness="0"
                             Padding="14,10"/>

                    <!-- Action Bar: Restore Button & Status Message -->
                    <Border Grid.Row="2" BorderBrush="#27272a" BorderThickness="0,1,0,0" Padding="14,10" Background="#18181b">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                       Foreground="#38bdf8" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <Button Grid.Column="1" Command="{Binding RestoreVersionCommand}"
                                    IsEnabled="{Binding HasSelectedVersion}"
                                    Background="#0284c7" Foreground="#ffffff"
                                    BorderBrush="#0369a1" BorderThickness="1"
                                    CornerRadius="6" Padding="14,7"
                                    FontWeight="Bold" FontSize="12" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconRestore}" Width="13" Height="13" Foreground="#ffffff" VerticalAlignment="Center"/>
                                    <TextBlock Text="Restore This Version" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER: Close & Safety Note -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Pre-restore safety guarantee: QuickNote automatically snapshots the current note before overwriting."
                       FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Click="CloseButton_Click"
                    Background="#27272a" Foreground="#cbd5e1"
                    BorderBrush="#3f3f46" BorderThickness="1"
                    CornerRadius="6" Padding="14,6" FontSize="12" Cursor="Hand">
                <TextBlock Text="Close"/>
            </Button>
        </Grid>
    </Grid>
</Window>
