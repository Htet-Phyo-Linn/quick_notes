<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:QuickNote.Avalonia.Views"
        x:Class="QuickNote.Avalonia.Views.TrashBinWindow"
        Title="Trash Bin"
        Width="700" Height="520"
        MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#222222"
        CanResize="true">

    <Window.Resources>
        <StreamGeometry x:Key="IconTrash">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
        <StreamGeometry x:Key="IconRestore">M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.2 3.16-1.98 5.12-1.98 3.89 0 7.14 2.78 7.84 6.43l2.44-.81C21.6 12.35 17.5 8 12.5 8z</StreamGeometry>
        <StreamGeometry x:Key="IconDocument">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- 1. Header & Search Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconTrash}" Width="16" Height="16" Foreground="#ef4444" VerticalAlignment="Center" />
                    <TextBlock Text="Trash Bin" FontWeight="Bold" FontSize="16" Foreground="#f3f4f6" VerticalAlignment="Center" />
                    <Border x:Name="ItemsCountBadge" Background="#374151" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ItemsCountText" Text="0 items" FontSize="11" Foreground="#9ca3af" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Recover accidentally deleted notes, or permanently empty trash." Foreground="#9ca3af" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Empty Trash Button -->
            <Button x:Name="EmptyTrashButton" Grid.Row="0" Grid.Column="1"
                    Click="EmptyTrashButton_Click"
                    Background="#7f1d1d" Foreground="#fca5a5"
                    BorderThickness="1" BorderBrush="#991b1b"
                    CornerRadius="5" Padding="12,6"
                    FontSize="12" FontWeight="SemiBold"
                    Cursor="Hand" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" Foreground="#fca5a5" VerticalAlignment="Center" />
                    <TextBlock Text="Empty Trash" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Search Filter Bar -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <PathIcon Data="{StaticResource IconSearch}" Width="12" Height="12" Foreground="#6b7280" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox"
                         TextChanged="SearchBox_TextChanged"
                         PlaceholderText="Filter deleted notes by name or folder..."
                         Background="#1c1c1c"
                         Foreground="#e5e7eb"
                         BorderBrush="#374151"
                         BorderThickness="1"
                         CornerRadius="5"
                         Padding="30,5,10,5"
                         Height="30"
                         FontSize="12" />
            </Grid>
        </Grid>

        <!-- 2. Main List of Trash Items -->
        <Border Grid.Row="1" Background="#18181b" CornerRadius="6" BorderBrush="#2d2d2d" BorderThickness="1">
            <Grid>
                <!-- Empty State Label -->
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="False">
                    <PathIcon Data="{StaticResource IconTrash}" Width="32" Height="32" Foreground="#4b5563" HorizontalAlignment="Center" />
                    <TextBlock Text="Trash Bin is empty." FontWeight="SemiBold" FontSize="14" Foreground="#9ca3af" HorizontalAlignment="Center" />
                    <TextBlock Text="Deleted notes and folders will appear here." FontSize="12" Foreground="#6b7280" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Items List -->
                <ListBox x:Name="TrashListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderBrush" Value="#27272a" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#27272a" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1e293b" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="views:TrashItemItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <!-- Type Icon -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" Foreground="#f59e0b" IsVisible="{Binding IsDirectory}" VerticalAlignment="Center" />
                                    <PathIcon Data="{StaticResource IconDocument}" Width="15" Height="15" Foreground="#60a5fa" IsVisible="{Binding !IsDirectory}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Title & Path -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#f3f4f6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OriginalPath}" FontSize="11" Foreground="#9ca3af" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Deletion Date -->
                                <TextBlock Grid.Column="2" Text="{Binding DeletedAtText}" FontSize="11.5" Foreground="#6b7280" VerticalAlignment="Center" Margin="0,0,14,0" />

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Tag="{Binding}"
                                            Click="ItemRestoreButton_Click"
                                            Background="#1e3a8a" Foreground="#93c5fd"
                                            BorderThickness="1" BorderBrush="#2563eb"
                                            CornerRadius="4" Padding="8,4"
                                            FontSize="11.5" FontWeight="SemiBold"
                                            Cursor="Hand" ToolTip.Tip="Restore this note to its original location">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource IconRestore}" Width="10" Height="10" Foreground="#93c5fd" VerticalAlignment="Center" />
                                            <TextBlock Text="Restore" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Tag="{Binding}"
                                            Click="ItemDeleteButton_Click"
                                            Background="#27272a" Foreground="#ef4444"
                                            BorderThickness="1" BorderBrush="#3f3f46"
                                            CornerRadius="4" Padding="6,4"
                                            FontSize="11"
                                            Cursor="Hand" ToolTip.Tip="Delete permanently">
                                        <PathIcon Data="{StaticResource IconTrash}" Width="11" Height="11" Foreground="#ef4444" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 3. Footer Actions -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="RestoreSelectedButton"
                        Click="RestoreSelectedButton_Click"
                        Content="Restore Selected"
                        Background="#2563eb" Foreground="White"
                        BorderThickness="0" CornerRadius="5"
                        Padding="14,7" FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand" />
                <Button x:Name="DeleteSelectedButton"
                        Click="DeleteSelectedButton_Click"
                        Content="Delete Selected"
                        Background="#374151" Foreground="#ef4444"
                        BorderThickness="0" CornerRadius="5"
                        Padding="14,7" FontSize="12"
                        Cursor="Hand" />
            </StackPanel>

            <Button Grid.Column="2"
                    Click="CloseButton_Click"
                    Content="Close"
                    Background="Transparent" Foreground="#9ca3af"
                    BorderThickness="1" BorderBrush="#3f3f46"
                    CornerRadius="5" Padding="16,7" FontSize="12"
                    Cursor="Hand" />
        </Grid>
    </Grid>
</Window>
