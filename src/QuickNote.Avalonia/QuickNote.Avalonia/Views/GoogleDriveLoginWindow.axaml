<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="QuickNote.Avalonia.Views.GoogleDriveLoginWindow"
        Title="Google Drive Sign In - QuickNote"
        Width="500" Height="480"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        CanResize="False">

    <Window.Resources>
        <StreamGeometry x:Key="IconCloud">M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
        <StreamGeometry x:Key="IconExternalLink">M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z</StreamGeometry>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="22">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#1e293b" Margin="0,0,12,0" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconCloud}" Width="22" Height="22" Foreground="#38bdf8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Connect Google Drive" FontWeight="Bold" FontSize="16" Foreground="#f8fafc" />
                <TextBlock Text="Authorize QuickNote to synchronize notes and attachments with your Google Drive account."
                           Foreground="#94a3b8" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Main Content Cards -->
        <StackPanel Grid.Row="1" Spacing="12">
            <!-- Step 1 Card: Open Browser -->
            <Border Background="#202028" BorderBrush="#31313e" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#2563eb" CornerRadius="10" Width="20" Height="20" VerticalAlignment="Center">
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Sign in with Google in your browser" FontWeight="SemiBold" FontSize="13" Foreground="#f1f5f9" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Opens the secure Google sign-in page in your default browser. Grant permissions to sync note files."
                               FontSize="11.5" Foreground="#94a3b8" TextWrapping="Wrap" />
                    <Button x:Name="BtnOpenBrowser"
                            Click="OpenBrowser_Click"
                            Background="#2563eb"
                            Foreground="White"
                            Height="36"
                            CornerRadius="6"
                            FontWeight="SemiBold"
                            FontSize="12.5"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconExternalLink}" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="Open Sign-In in Default Browser" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Step 2 Card: Enter Code or URL -->
            <Border Background="#202028" BorderBrush="#31313e" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="#059669" CornerRadius="10" Width="20" Height="20" VerticalAlignment="Center">
                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Complete Authorization" FontWeight="SemiBold" FontSize="13" Foreground="#f1f5f9" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Paste the code or full redirect URL (http://localhost/?code=...) from your browser below:"
                               FontSize="11.5" Foreground="#94a3b8" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 x:Name="AuthCodeInputBox"
                                 PlaceholderText="Paste code or http://localhost/?code=..."
                                 Background="#14141a"
                                 Foreground="#f8fafc"
                                 BorderBrush="#38384a"
                                 BorderThickness="1"
                                 CornerRadius="6,0,0,6"
                                 Padding="10,7"
                                 FontSize="12"
                                 KeyDown="AuthCodeInputBox_KeyDown" />
                        <Button Grid.Column="1"
                                x:Name="BtnComplete"
                                Click="CompleteSignIn_Click"
                                Content="Complete Sign In"
                                Background="#10b981"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="0,6,6,0"
                                Padding="14,7"
                                FontWeight="SemiBold"
                                FontSize="12"
                                Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Status & Progress -->
        <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,6">
            <ProgressBar x:Name="LoginProgressBar"
                         IsIndeterminate="True"
                         Height="2.5"
                         HorizontalAlignment="Stretch"
                         Foreground="#38bdf8"
                         Background="#252530"
                         BorderThickness="0"
                         IsVisible="False" />
            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready to sign in with Google Drive"
                       FontSize="11.5"
                       Foreground="#94a3b8"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="BtnCancel"
                    Click="Close_Click"
                    Content="Cancel"
                    Background="Transparent"
                    Foreground="#94a3b8"
                    BorderThickness="0"
                    Padding="14,6"
                    FontSize="12"
                    Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>